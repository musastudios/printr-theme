[
  {
    "name": "theme_info",
    "theme_name": "PRINTR",
    "theme_version": "1.0.0",
    "theme_author": "PRINTR",
    "theme_documentation_url": "https://kawascopy.com",
    "theme_support_url": "https://kawascopy.com"
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#111111"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button",
            "default": "#111111"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#C4301C"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Border",
            "default": "#E6E6E6"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "icons": "text",
          "links": "accent"
        }
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge",
        "default": "#C4301C"
      },
      {
        "type": "color",
        "id": "color_badge_new",
        "label": "New badge",
        "default": "#0D8756"
      },
      {
        "type": "color",
        "id": "color_cart_bubble",
        "label": "Cart bubble",
        "default": "#C4301C"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "space_grotesk_n7"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "instrument_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      }
    ]
  },
  {
    "name": "Print identity",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_crop_marks",
        "label": "Show crop marks on cards and banners",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "paper_texture",
        "label": "Paper grain texture on background",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cmyk_bar",
        "label": "Show CMYK registration strip",
        "default": true
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Smooth page transitions",
        "info": "Uses native cross-document view transitions in supporting browsers. Disabled automatically for reduced motion.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_scroll_progress",
        "label": "Show scroll progress bar",
        "default": false
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show color swatches",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Enable quick add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_from_price",
        "label": "Show 'From' price for tiered products",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_view",
        "label": "Show quick view button",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (store currency, 0 to hide)",
        "default": "75"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order notes (artwork instructions)",
        "default": true
      }
    ]
  },
  {
    "name": "Shopping tools",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_wishlist",
        "label": "Enable wishlist",
        "info": "Saved in the shopper's browser. Create a page using the 'page.wishlist' template and link it in your menu.",
        "default": true
      },
      {
        "type": "page",
        "id": "wishlist_page",
        "label": "Wishlist page"
      },
      {
        "type": "checkbox",
        "id": "enable_compare",
        "label": "Enable product compare",
        "info": "Compare up to 4 products side by side.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_back_to_top",
        "label": "Show back-to-top button",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      }
    ]
  }
]