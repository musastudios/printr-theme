<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'printr-mark.svg' | asset_url }}">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {%- if settings.page_transitions -%}<style>@media (prefers-reduced-motion: no-preference){@view-transition{navigation:auto}}</style>{%- endif -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'features.js' | asset_url }}" type="module" defer="defer"></script>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.routes = {
        root: {{ routes.root_url | json }},
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        cart_url: {{ routes.cart_url | json }},
        predictive_search_url: {{ routes.predictive_search_url | json }}
      };
      window.themeStrings = {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        error: {{ 'general.error' | t | json }},
        loading: {{ 'accessibility.loading' | t | json }},
        wishlistAdded: {{ 'products.wishlist.added' | t | json }},
        wishlistRemoved: {{ 'products.wishlist.removed' | t | json }},
        compareFull: {{ 'products.compare.full' | t | json }},
        compareAdded: {{ 'products.compare.added' | t | json }},
        compareRemoved: {{ 'products.compare.removed' | t | json }},
        compareCleared: {{ 'products.compare.cleared' | t | json }},
        remove: {{ 'general.remove' | t | json }},
        moreLoaded: {{ 'sections.collection.more_loaded' | t: count: '{{ count }}' | json }},
        noRates: {{ 'sections.cart.estimate.none' | t | json }},
        free: {{ 'sections.cart.estimate.free' | t | json }}
      };
    </script>
    {{ content_for_header }}
  </head>
  <body data-cart-type="{{ settings.cart_type }}" class="{% if settings.animations_reveal %}has-motion{% endif %}{% if settings.page_transitions %} vt{% endif %}{% if settings.paper_texture %} paper{% endif %}{% if settings.show_crop_marks %} crop-on{% endif %}{% if settings.brand_gradient %} brand-gradient{% endif %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    {% section 'quick-view' %}
    {% section 'compare-bar' %}
    {% section 'newsletter-popup' %}
    {%- if settings.show_back_to_top -%}
      <button type="button" class="back-to-top" data-back-to-top aria-label="{{ 'accessibility.back_to_top' | t }}">{% render 'icon', name: 'arrow-up' %}</button>
    {%- endif -%}
    {%- if settings.show_scroll_progress -%}<div class="scroll-progress" aria-hidden="true"></div>{%- endif -%}
  </body>
</html>
