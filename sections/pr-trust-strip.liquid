{%- comment -%}
  Compact boutique trust strip: tactile finishes, designer file review,
  reprint guarantee, and the first-order 15% offer, plus optional
  verbatim testimonials. No review counts or invented quotes.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  assign quotes_heading = section.settings.quotes_heading
  assign show_quotes = false
  for block in section.blocks
    if block.type == 'quote' and block.settings.quote != blank
      assign show_quotes = true
    endif
  endfor
  unless section.settings.show_quotes
    assign show_quotes = false
  endunless
-%}
<section class="section pts pts--compact color-{{ section.settings.color_scheme }}" aria-labelledby="PtsHeading-{{ section.id }}">
  <div class="cmyk-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="page-width">
    {%- if heading != blank -%}
      <h2 id="PtsHeading-{{ section.id }}" class="pts__heading" data-reveal>{{ heading | escape }}</h2>
    {%- else -%}
      <h2 id="PtsHeading-{{ section.id }}" class="visually-hidden">{{ 'trust_strip.heading' | t }}</h2>
    {%- endif -%}

    <ul class="pts__items" role="list" data-reveal>
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          {%- liquid
            assign title = block.settings.title
            assign text = block.settings.text
            assign icon = block.settings.icon | default: 'check'
            assign link = block.settings.link
          -%}
          <li class="pts__item" {{ block.shopify_attributes }}>
            <span class="pts__icon" aria-hidden="true">{% render 'icon', name: icon %}</span>
            <div class="pts__copy">
              {%- if title != blank -%}
                {%- if link != blank -%}
                  <a class="pts__title" href="{{ link }}">{{ title | escape }}</a>
                {%- else -%}
                  <p class="pts__title">{{ title | escape }}</p>
                {%- endif -%}
              {%- endif -%}
              {%- if text != blank -%}<p class="pts__text">{{ text | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if show_quotes -%}
      <div class="pts__proof" data-reveal>
        {%- if quotes_heading != blank -%}
          <p class="pts__proof-label">{{ quotes_heading | escape }}</p>
        {%- endif -%}
        <ul class="pts__quotes" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'quote' and block.settings.quote != blank -%}
              <li {{ block.shopify_attributes }}>
                <figure class="pts__quote">
                  <blockquote>{{ block.settings.quote }}</blockquote>
                  {%- if block.settings.author != blank or block.settings.role != blank -%}
                    <figcaption>
                      {%- if block.settings.author != blank -%}<strong>{{ block.settings.author | escape }}</strong>{%- endif -%}
                      {%- if block.settings.role != blank -%}
                        {%- if block.settings.author != blank %} · {% endif -%}
                        {{ block.settings.role | escape }}
                      {%- endif -%}
                    </figcaption>
                  {%- endif -%}
                </figure>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
  .section.pts--compact { padding-block: 2.4rem; padding-top: 0; }
  .pts .cmyk-bar { margin-bottom: 2.4rem; }
  .pts__heading { margin: 0 0 2rem; font-size: calc(var(--font-heading-scale) * 2.2rem); }
  .pts__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
  }
  .pts__item {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    min-width: 0;
  }
  .pts__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: rgb(var(--color-accent));
    color: rgb(var(--color-background));
  }
  .pts__icon .icon { width: 2.2rem; height: 2.2rem; }
  .pts__copy { min-width: 0; }
  .pts__title {
    display: block;
    margin: 0 0 .2rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.6rem;
    letter-spacing: -.01em;
    line-height: 1.2;
    color: inherit;
    text-decoration: none;
  }
  a.pts__title:hover,
  a.pts__title:focus-visible { text-decoration: underline; text-underline-offset: .25em; }
  .pts__text { margin: 0; font-size: 1.4rem; line-height: 1.45; opacity: .82; }
  .pts__proof {
    margin-top: 2rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgb(var(--color-border));
  }
  .pts__proof-label {
    margin: 0 0 1.2rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .pts__quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
    grid-template-columns: 1fr;
  }
  .pts__quote { margin: 0; display: grid; gap: .6rem; }
  .pts__quote blockquote {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.45;
    font-style: italic;
  }
  .pts__quote blockquote p { margin: 0; }
  .pts__quote figcaption { font-size: 1.3rem; opacity: .8; }
  @media (min-width: 600px) {
    .pts__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 2.4rem; }
  }
  @media (min-width: 990px) {
    .section.pts--compact { padding-block: 2.8rem; padding-top: 0; }
    .pts__items { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
    .pts__quotes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Trust strip",
  "class": "section-pr-trust-strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to hide the visible heading. A screen-reader heading is still output." },
    { "type": "checkbox", "id": "show_quotes", "label": "Show real testimonials", "default": true, "info": "Only renders quotes entered in the Quote blocks. Do not invent review counts." },
    { "type": "text", "id": "quotes_heading", "label": "Testimonials label", "default": "Loved by local businesses" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Guarantee",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "print", "label": "Print" },
          { "value": "eye", "label": "Eye" },
          { "value": "check", "label": "Check" },
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "chat", "label": "Chat" },
          { "value": "pin", "label": "Pin" },
          { "value": "truck", "label": "Truck" },
          { "value": "clock", "label": "Clock" },
          { "value": "mail", "label": "Mail" }
        ], "default": "print" },
        { "type": "text", "id": "title", "label": "Title", "default": "Boutique-grade print & tactile finishes" },
        { "type": "text", "id": "text", "label": "Text", "default": "Raised Foil, Suede soft-touch, and rich stocks you can feel." },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "info": "Reuse a live storefront testimonial. Do not invent quotes or review counts." },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "print", "title": "Boutique-grade print & tactile finishes", "text": "Raised Foil, Suede soft-touch, and rich stocks you can feel." } },
        { "type": "item", "settings": { "icon": "eye", "title": "Expert designer file review", "text": "Real designers check bleed, resolution, and finish alignment before press." } },
        { "type": "item", "settings": { "icon": "check", "title": "100% Reprint Guarantee", "text": "If it's not right, we reprint it." } },
        { "type": "item", "settings": { "icon": "sparkle", "title": "15% OFF your first print run", "text": "Join the list and confirm your email for a unique 15% OFF code. Products only; excludes shipping & taxes." } }
      ]
    }
  ]
}
{% endschema %}
