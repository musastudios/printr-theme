<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.compact %} section--compact{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 data-reveal>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="grid multicolumn" style="--cols: {{ section.settings.columns }}; --cols-mobile: 1" data-reveal>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% stylesheet %}
  .section--compact { padding-block: 4rem; }
{% endstylesheet %}
{% schema %}
{
  "name": "Multicolumn",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "compact", "label": "Compact spacing", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Multicolumn", "blocks": [{ "type": "icon-column" }, { "type": "icon-column" }, { "type": "icon-column" }] },
    { "name": "Testimonials", "settings": { "heading": "Loved by local businesses", "columns": 3 }, "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }
  ]
}
{% endschema %}
