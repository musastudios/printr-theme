<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width favorites">
    <div class="favorites__feature media crop">
      {%- if section.settings.image -%}
        {%- assign focal = section.settings.image.presentation.focal_point | prepend: 'object-position: ' -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 900, 1400', sizes: '(min-width: 990px) 40vw, 100vw', style: focal }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
      <div class="favorites__caption">
        <span class="slug">{{ section.settings.slug | escape }}</span>
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.link_label != blank -%}<a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <carousel-track class="favorites__track">
      <ul class="carousel" role="list" data-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
        {%- for p in section.settings.products -%}
          <li class="carousel__slide">{% render 'product-card', product: p, sizes: '(min-width: 990px) 22vw, 70vw' %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}<li class="carousel__slide"><div class="media crop">{{ 'product-3' | placeholder_svg_tag: 'placeholder' }}</div></li>{%- endfor -%}
        {%- endfor -%}
      </ul>
      <div class="carousel__nav">
        <button type="button" class="icon-button" data-prev>{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden">{{ 'general.slider.previous' | t }}</span></button>
        <button type="button" class="icon-button" data-next>{% render 'icon', name: 'arrow-right' %}<span class="visually-hidden">{{ 'general.slider.next' | t }}</span></button>
      </div>
    </carousel-track>
  </div>
</div>
{% stylesheet %}
  .favorites { display: grid; gap: 3.2rem; align-items: stretch; }
  @media (min-width: 990px) { .favorites { grid-template-columns: 5fr 7fr; } }
  .favorites__feature { position: relative; min-height: 48rem; }
  .favorites__feature img { position: absolute; inset: 0; height: 100%; object-fit: cover; }
  .favorites__caption { position: absolute; inset: auto 0 0; padding: 3.2rem; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.65)); display: grid; gap: 1rem; justify-items: start; }
  .favorites__track { align-self: center; min-width: 0; }
  .favorites__track .carousel__slide { flex-basis: min(30rem, 72%); }
{% endstylesheet %}
{% schema %}
{
  "name": "Favorite products",
  "settings": [
    { "type": "text", "id": "slug", "label": "Eyebrow", "default": "Customer favorites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reordered again and again" },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Favorite products" }]
}
{% endschema %}
