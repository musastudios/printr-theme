{%- assign c = section.settings.collection -%}
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <div>
        {%- if section.settings.slug != blank -%}<span class="slug">{{ section.settings.slug | escape }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if c != blank -%}<a class="button button--secondary" href="{{ c.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.columns }}">
      {%- if c != blank -%}
        {%- for product in c.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="card"><div class="media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div><h3 class="card__title">Business cards</h3></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>
{% stylesheet %}
  .product-grid { list-style: none; padding: 0; margin: 0; }
{% endstylesheet %}
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "slug", "label": "Small label", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most printed this week" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
