{%- if section.settings.enable -%}
  {%- form 'customer', id: 'PopupForm', class: 'popup__form' -%}
    {%- assign success = form.posted_successfully? -%}
    <newsletter-popup data-delay="{{ section.settings.delay }}" data-frequency="{{ section.settings.frequency }}" data-exit-intent="{{ section.settings.exit_intent }}" data-success="{{ success }}" data-home="{% if request.page_type == 'index' %}true{% else %}false{% endif %}">
      <dialog class="modal popup color-{{ section.settings.color_scheme }}" role="dialog" aria-modal="true" aria-labelledby="PopupTitle">
        <div class="popup__grid crop">
          {%- if section.settings.image -%}
            <div class="popup__media">{%- assign focal = section.settings.image.presentation.focal_point | prepend: 'object-position: ' -%}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 750px) 40rem, 0px', alt: '', style: focal }}</div>
          {%- endif -%}
          <div class="popup__body">
            <button type="button" class="icon-button popup__close" data-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
            {%- if success -%}
              <span class="slug">{{ section.settings.slug | escape }}</span>
              <h2 id="PopupTitle">{{ 'general.newsletter.success' | t }}</h2>
              {%- if section.settings.code != blank -%}
                <p>{{ 'general.newsletter.use_code' | t }}</p>
                <p class="popup__code"><code>{{ section.settings.code | escape }}</code></p>
              {%- endif -%}
            {%- else -%}
              <span class="slug">{{ section.settings.slug | escape }}</span>
              <h2 id="PopupTitle">{{ section.settings.heading | escape }}</h2>
              <div class="rte">{{ section.settings.text }}</div>
              <input type="hidden" name="contact[tags]" value="newsletter,popup">
              <div class="field field--inline">
                <label class="visually-hidden" for="PopupEmail">{{ 'general.newsletter.email' | t }}</label>
                <input id="PopupEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.newsletter.email' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="PopupError"{% endif %}>
                <button type="submit" class="button">{{ 'general.newsletter.subscribe' | t }}</button>
              </div>
              {%- if form.errors -%}<p id="PopupError" class="form-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
              <button type="button" class="link popup__dismiss" data-close>{{ 'general.newsletter.no_thanks' | t }}</button>
            {%- endif -%}
          </div>
        </div>
      </dialog>
    </newsletter-popup>
  {%- endform -%}
{%- endif -%}
{% stylesheet %}
  .popup { padding: 0; max-width: min(88rem, calc(100vw - 3.2rem)); }
  .popup[open] { position: fixed; inset: 0; margin: auto; max-height: calc(100vh - 3.2rem); overflow: auto; z-index: 50; box-shadow: 0 0 0 100vmax rgba(0, 0, 0, .5); }
  .popup__grid { display: grid; }
  .popup__media img { height: 100%; object-fit: cover; }
  .popup__body { position: relative; padding: clamp(3.2rem, 5vw, 5.6rem); display: grid; gap: 1.2rem; align-content: center; }
  .popup__close { position: absolute; top: 1.2rem; right: 1.2rem; }
  .popup__code code { font-size: 2.4rem; letter-spacing: .1em; padding: .8rem 1.6rem; border: 2px dashed currentColor; display: inline-block; }
  .popup__dismiss { justify-self: start; }
  .field--inline { display: flex; gap: .8rem; flex-wrap: wrap; }
  .field--inline input { flex: 1 1 20rem; }
  @media (min-width: 750px) { .popup__grid:has(.popup__media) { grid-template-columns: 1fr 1.2fr; } }
  @media (max-width: 749px) { .popup__media { display: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable popup", "default": false },
    { "type": "range", "id": "delay", "label": "Delay", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 10 },
    { "type": "range", "id": "frequency", "label": "Show again after", "min": 1, "max": 60, "step": 1, "unit": "d", "default": 14 },
    { "type": "checkbox", "id": "exit_intent", "label": "Also open on exit intent (desktop)", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "slug", "label": "Eyebrow", "default": "First order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first print run" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join for printing tips, new paper stocks and members-only deals.</p>" },
    { "type": "text", "id": "code", "label": "Discount code shown after signup", "default": "INK10" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
