{%- comment -%}
  Mega menu data. Flattens the menu into parallel arrays (depth, title, handle, url, thumb product)
  and works out visibility: a collection link with 0 products is hidden, and a link without a
  collection is hidden when it has children and all of them are hidden.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  assign sale_key = section.settings.highlight_item | strip | downcase
  assign rs = '^'
  if section.settings.demo_tree
    capture rows
      render 'mega-demo-tree'
    endcapture
    assign rows = rows | strip | newline_to_br | replace: '<br />', rs | strip_newlines
  else
    assign rows = ''
    for l1 in menu.links
      assign h = ''
      if l1.type == 'collection_link'
        assign h = l1.object.handle
      endif
      assign rows = rows | append: rs | append: '1|' | append: l1.title | append: '|' | append: h | append: '|' | append: l1.url | append: '|'
      for l2 in l1.links
        assign h = ''
        if l2.type == 'collection_link'
          assign h = l2.object.handle
        endif
        assign rows = rows | append: rs | append: '2|' | append: l2.title | append: '|' | append: h | append: '|' | append: l2.url | append: '|'
        for l3 in l2.links
          assign h = ''
          if l3.type == 'collection_link'
            assign h = l3.object.handle
          endif
          assign rows = rows | append: rs | append: '3|' | append: l3.title | append: '|' | append: h | append: '|' | append: l3.url | append: '|'
        endfor
      endfor
    endfor
  endif
  assign row_list = rows | split: rs
  assign d_s = ''
  assign t_s = ''
  assign h_s = ''
  assign u_s = ''
  assign i_s = ''
  assign c_s = ''
  for row in row_list
    if row == blank
      continue
    endif
    assign f = row | append: '| | | | ' | split: '|'
    assign hh = f[2] | strip
    assign uu = f[3] | strip
    assign cc = ''
    if hh != blank
      assign col = collections[hh]
      if col.id != blank
        assign cc = col.products_count | append: ''
        if uu == blank
          assign uu = col.url
        endif
      endif
    endif
    assign d_s = d_s | append: rs | append: f[0]
    assign t_s = t_s | append: rs | append: f[1]
    assign h_s = h_s | append: rs | append: hh | append: ' '
    assign u_s = u_s | append: rs | append: uu | append: ' '
    assign i_s = i_s | append: rs | append: f[4] | append: ' '
    assign c_s = c_s | append: rs | append: cc | append: ' '
  endfor
  assign m_depths = d_s | remove_first: rs | split: rs
  assign m_titles = t_s | remove_first: rs | split: rs
  assign m_handles = h_s | remove_first: rs | split: rs
  assign m_urls = u_s | remove_first: rs | split: rs
  assign m_imgs = i_s | remove_first: rs | split: rs
  assign m_counts = c_s | remove_first: rs | split: rs
  assign last = m_depths.size | minus: 1
  assign v_s = ''
  assign hc2 = false
  assign hc3 = false
  assign hc4 = false
  assign av2 = false
  assign av3 = false
  assign av4 = false
  if last >= 0
    for i in (0..last) reversed
      assign d = m_depths[i]
      assign hh = m_handles[i] | strip
      assign uu = m_urls[i] | strip
      assign cc = m_counts[i] | strip
      assign key = m_titles[i] | strip | downcase
      case d
        when '1'
          assign has_kids = hc2
          assign any_kid = av2
        when '2'
          assign has_kids = hc3
          assign any_kid = av3
        else
          assign has_kids = hc4
          assign any_kid = av4
      endcase
      assign v = true
      if hh != blank
        if cc != blank
          if cc == '0'
            assign v = false
          endif
        elsif uu == blank
          assign v = false
        endif
      elsif has_kids and any_kid == false
        assign v = false
      endif
      if uu == blank
        assign v = false
      endif
      if section.settings.show_empty_highlight and sale_key != blank and key == sale_key
        assign v = true
      endif
      case d
        when '1'
          assign hc2 = false
          assign av2 = false
        when '2'
          assign hc3 = false
          assign av3 = false
          assign hc2 = true
          if v
            assign av2 = true
          endif
        else
          assign hc3 = true
          if v
            assign av3 = true
          endif
      endcase
      if v
        assign v_s = '1' | append: rs | append: v_s
      else
        assign v_s = '0' | append: rs | append: v_s
      endif
    endfor
  endif
  assign m_vis = v_s | split: rs
-%}
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
<sticky-header class="header-wrap{% if section.settings.sticky %} is-sticky-enabled{% endif %}">
<header class="header color-{{ section.settings.color_scheme }}">
  <div class="page-width header__main">
    <button type="button" class="icon-button header__menu-toggle" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-expanded="false">
      {% render 'icon', name: 'menu' %}<span class="visually-hidden">{{ 'accessibility.menu' | t }}</span>
    </button>
    <a href="{{ routes.root_url }}" class="header__logo" style="--logo-width: {{ settings.logo_width }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: width: settings.logo_width, height: null, widths: '150, 300, 450, 600', alt: shop.name, preload: true, sizes: '(min-width: 750px) 200px, 140px' }}
      {%- elsif settings.show_brand_logo -%}
        {% render 'printr-logo', uid: 'header', class: 'header__brand-logo' %}<span class="visually-hidden">{{ shop.name }}</span>
      {%- else -%}
        <span class="header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <predictive-search class="header__search" data-category-search>
      <form action="{{ routes.search_url }}" method="get" role="search" class="header-search">
        {%- if section.settings.show_categories and shop.types.size > 0 -%}
          <div class="header-search__cat">
            <label class="visually-hidden" for="HeaderSearchCat-{{ section.id }}">{{ 'sections.header.category' | t }}</label>
            <select id="HeaderSearchCat-{{ section.id }}" data-search-category>
              <option value="">{{ 'sections.header.all_categories' | t }}</option>
              {%- for type in shop.types -%}
                {%- if type != blank -%}<option value="{{ type | escape }}">{{ type | escape }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down' %}
          </div>
        {%- endif -%}
        <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">{{ 'accessibility.search' | t }}</label>
        <input id="HeaderSearch-{{ section.id }}" class="header-search__input" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="HeaderResults-{{ section.id }}" data-search-input>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="header-search__submit">{% render 'icon', name: 'search' %}<span class="visually-hidden">{{ 'accessibility.search' | t }}</span></button>
      </form>
      <div id="HeaderResults-{{ section.id }}" class="header-search__results" data-results hidden aria-live="polite"></div>
    </predictive-search>

    <div class="header__icons">
      <button type="button" class="icon-button header__search-toggle" data-drawer-open="SearchDrawer" aria-controls="SearchDrawer" aria-expanded="false">
        {% render 'icon', name: 'search' %}<span class="visually-hidden">{{ 'accessibility.search' | t }}</span>
      </button>
      {%- if section.settings.store_link != blank -%}
        <a class="header__action" href="{{ section.settings.store_link }}">{% render 'icon', name: 'pin' %}<span>{{ section.settings.store_label | escape }}</span></a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <div class="header__action header__action--account">
          <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu }}">
            <span slot="signed-out-avatar" class="header__account-avatar">{% render 'icon', name: 'account' %}</span>
          </shopify-account>
          <a class="header__account-label" href="{{ routes.account_url }}">{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'sections.header.sign_in' | t }}{% endif %}</a>
        </div>
      {%- endif -%}
      {%- if settings.enable_wishlist -%}
        <a class="icon-button" href="{{ settings.wishlist_page.url | default: '/pages/wishlist' }}">
          {% render 'icon', name: 'heart' %}<span class="visually-hidden">{{ 'products.wishlist.title' | t }}</span>
          <span class="cart-bubble" data-wishlist-count hidden></span>
        </a>
      {%- endif -%}
      <a class="icon-button header__cart" href="{{ routes.cart_url }}" {% if settings.cart_type == 'drawer' %}data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false"{% endif %}>
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'accessibility.cart' | t }}</span>
        <span class="cart-bubble" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="header__nav" aria-label="{{ 'accessibility.menu' | t }}">
    {% render 'mega-nav', depths: m_depths, titles: m_titles, handles: m_handles, urls: m_urls, imgs: m_imgs, vis: m_vis, counts: m_counts, blocks: section.blocks, highlight: section.settings.highlight_item %}
  </nav>
  {%- if settings.show_cmyk_bar -%}
    <div class="cmyk-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  {%- endif -%}
</header>
</sticky-header>

<drawer-panel id="MenuDrawer" class="drawer drawer--left" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__header">
      <span class="slug">{{ 'accessibility.menu' | t }}</span>
      <button type="button" class="icon-button" data-drawer-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'accessibility.close_menu' | t }}</span></button>
    </div>
    {% render 'mega-drawer', depths: m_depths, titles: m_titles, handles: m_handles, urls: m_urls, imgs: m_imgs, vis: m_vis, counts: m_counts, blocks: section.blocks, highlight: section.settings.highlight_item %}
    <div class="mobile-menu__footer">
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">{% render 'icon', name: 'account' %}{{ 'sections.header.sign_in' | t }}</a>{%- endif -%}
      {%- if section.settings.store_link != blank -%}<a href="{{ section.settings.store_link }}">{% render 'icon', name: 'pin' %}{{ section.settings.store_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</drawer-panel>

<drawer-panel id="SearchDrawer" class="drawer drawer--top" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.search' | t }}">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel search-panel">
    <div class="drawer__header">
      <span class="slug">{{ 'accessibility.search' | t }}</span>
      <button type="button" class="icon-button" data-drawer-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
    </div>
    <predictive-search class="search-panel__body">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="HeaderSearch">{{ 'accessibility.search' | t }}</label>
        <input id="HeaderSearch" type="search" name="q" data-autofocus placeholder="{{ 'sections.search.placeholder' | t }}" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="PredictiveResults">
        <input type="hidden" name="options[prefix]" value="last">
      </form>
      <div id="PredictiveResults" data-results hidden aria-live="polite"></div>
    </predictive-search>
  </div>
</drawer-panel>

{% stylesheet %}
  .header-wrap { display: block; position: relative; z-index: 40; }
  .header-wrap.is-sticky-enabled { position: sticky; top: 0; }
  .header { border-bottom: 1px solid rgb(var(--color-border)); transition: box-shadow .25s; }
  .header-wrap.is-stuck .header { box-shadow: 0 6px 24px rgba(0,0,0,.08); }
  .header__main { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.2rem; min-height: 6.4rem; }
  .header__logo { text-decoration: none; color: rgb(var(--color-foreground)); display: inline-flex; justify-self: center; }
  .header__wordmark { font-family: var(--font-heading-family); font-weight: 800; font-size: 2.6rem; letter-spacing: -0.04em; }
  .header__brand-logo { width: calc(var(--logo-width, 140) * 1px); max-width: 36vw; height: auto; display: block; }
  .header__search { display: none; position: relative; }
  .header-search { display: flex; align-items: center; background: rgba(var(--color-foreground), .06); border: 1px solid rgba(var(--color-foreground), .1); border-radius: 99px; height: 4.8rem; padding: 0 .4rem 0 0; transition: border-color .2s, box-shadow .2s; }
  .header-search:focus-within { border-color: rgb(var(--color-foreground)); box-shadow: 0 0 0 3px var(--c); }
  .header-search__cat { position: relative; display: flex; align-items: center; flex: none; border-right: 1px solid rgba(var(--color-foreground), .2); }
  .header-search__cat select { appearance: none; background: transparent; border: 0; font: inherit; font-weight: 600; font-size: 1.4rem; padding: 0 3.2rem 0 2rem; height: 3.2rem; width: auto; max-width: 18rem; cursor: pointer; color: inherit; }
  .header-search__cat .icon { position: absolute; right: 1.2rem; width: 1.4rem; height: 1.4rem; pointer-events: none; }
  .header-search__input { flex: 1; min-width: 0; border: 0 !important; background: transparent !important; box-shadow: none !important; padding: 0 1.6rem !important; height: 100%; font-size: 1.5rem; outline: none; }
  .header-search__submit { width: 4rem; height: 4rem; border-radius: 50%; border: 0; background: var(--y); color: #000; display: grid; place-items: center; cursor: pointer; flex: none; }
  .header-search__submit .icon { width: 2rem; height: 2rem; }
  .header-search__results { position: absolute; top: calc(100% + .8rem); left: 0; right: 0; background: rgb(var(--color-background)); border: 1px solid rgb(var(--color-border)); border-radius: 1.6rem; box-shadow: 0 20px 50px rgba(0,0,0,.14); padding: 1.6rem; max-height: 70vh; overflow: auto; z-index: 5; }
  .header__icons { display: flex; justify-content: flex-end; align-items: center; gap: .4rem; }
  .header__action { display: none; align-items: center; gap: .8rem; font-weight: 600; font-size: 1.4rem; text-decoration: none; color: inherit; padding: 0 .8rem; min-height: 4.4rem; white-space: nowrap; }
  .header__action .icon { width: 2.2rem; height: 2.2rem; }
  .header__account { --shopify-account-signed-in-avatar-size: 28px; --shopify-account-signed-in-avatar-color-background: var(--m); display: inline-flex; align-items: center; }
  .header__account-avatar { display: inline-flex; }
  .header__account-label { text-decoration: none; color: inherit; }
  .header__account-label:hover, .header__action:hover { text-decoration: underline; text-underline-offset: 4px; }
  .header__cart { background: rgba(var(--color-foreground), .06); border-radius: 50%; }
  .cart-bubble { position: absolute; top: 0; right: 0; min-width: 1.8rem; height: 1.8rem; border-radius: 99px; background: var(--color-cart-bubble); color: #fff; font-size: 1.1rem; display: grid; place-items: center; }
  .cart-bubble[hidden] { display: none; }
  .header__nav { display: none; border-top: 1px solid rgb(var(--color-border)); }
  /* Mega menu (spec: single 2px black underline, square corners, full-width panels) */
  .header__nav { position: static; }
  .header { position: relative; }
  .header__menu { display: flex; gap: 2.8rem; list-style: none; margin: 0 auto; flex-wrap: nowrap; }
  .header__item { position: static; }
  .header__link { display: inline-flex; align-items: center; gap: .4rem; font: inherit; font-weight: 700; font-size: 1.5rem; text-decoration: none; cursor: pointer; padding: 1.4rem 0; color: inherit; background: none; border: 0; border-bottom: 2px solid transparent; border-radius: 0; margin-bottom: -1px; }
  .header__link .icon { width: 1.4rem; height: 1.4rem; }
  .header__link:hover, .header__link:focus-visible, .header__link.is-current, .header__link[aria-expanded="true"] { border-bottom-color: #000; }
  .header__link[aria-expanded="true"] .icon { rotate: 180deg; }
  .header__link:focus-visible, .mega a:focus-visible, .mega button:focus-visible, .mobile-menu :focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  .header__link.is-sale, .mobile-menu .is-sale { color: #D4145A; }
  .mega { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; background: #fff; color: #000; border-top: 1px solid #000; border-bottom: 2px solid #000; }
  .mega[hidden] { display: none; }
  .mega__wrap { display: flex; gap: 4rem; padding-block: 3.2rem 3.6rem; align-items: flex-start; }
  .mega a { color: inherit; text-decoration: none; }
  .mega__cols { flex: 1; display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: 2.4rem 3.2rem; align-content: start; }
  .mega--mega_compact .mega__cols, .mega--dropdown .mega__cols { flex: 0 1 28rem; }
  .mega__cols--flow .mega__col--flow { grid-column: 1 / -1; }
  .mega__cols--flow .mega__col--flow ul { display: block; columns: var(--cols); column-gap: 3.2rem; }
  .mega__cols--flow .mega__col--flow li { break-inside: avoid; margin-bottom: .8rem; }
  .mega__col ul { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .8rem; }
  .mega__col ul a { font-size: 1.4rem; }
  .mega__col ul a.mega__lone { font-size: 1.5rem; font-weight: 700; }
  .mega__cols--thumbs .mega__thumbs { grid-column: 1 / -1; margin-top: 1.2rem; }
  .mega__col ul a:hover, .mega__viewall:hover, .mega__thead a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .mega__title, .mega__eyebrow { display: block; font-size: 1.15rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  .mega__viewall { grid-column: 1 / -1; font-weight: 700; font-size: 1.4rem; }
  .mega__showroom { flex: 1; display: grid; grid-template-columns: 24rem minmax(0, 1fr); gap: 0 3.2rem; }
  .mega__tabs { grid-row: 1 / span 20; display: flex; flex-direction: column; gap: .2rem; }
  .mega__tabs [role=tab] { display: flex; justify-content: space-between; align-items: center; text-align: left; font: inherit; font-weight: 700; font-size: 1.4rem; padding: .9rem 1.2rem; background: none; border: 0; border-left: 3px solid transparent; color: inherit; cursor: pointer; border-radius: 0; }
  .mega__tabs [role=tab] .icon { width: 1.2rem; height: 1.2rem; opacity: .5; }
  .mega__tabs [aria-selected=true] { background: #F9F7F1; border-left-color: #000; }
  .mega__tabs .mega__viewall { margin-top: 1.6rem; padding-left: 1.2rem; }
  .mega__tabpanel { grid-column: 2; display: flex; gap: 3.2rem; align-items: flex-start; }
  .mega__tabpanel[hidden] { display: none; }
  .mega__tabmain { flex: 1; min-width: 0; }
  .mega__thead { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.6rem; }
  .mega__thead h3 { margin: 0; font-size: 1.8rem; }
  .mega__thead a { font-weight: 700; font-size: 1.3rem; }
  .mega__thumbs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: 1.6rem; }
  .mega__thumb { display: grid; gap: .6rem; text-align: center; font-size: 1.3rem; font-weight: 600; }
  .mega__thumb-media, .mobile-showroom__grid .mega__thumb-media { display: block; aspect-ratio: var(--ratio, 1 / 1); background: #F9F7F1; border: 1px solid #E6E3DA; overflow: hidden; }
  .mega__thumb-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mega__thumb-ph { width: 100%; height: 100%; display: block; fill: #C9C5BA; background: #F9F7F1; }
  .mega__thumb:hover .mega__thumb-label { text-decoration: underline; text-underline-offset: 3px; }
  .mega__promo { flex: 0 0 28rem; }
  .mega__promo-card { display: block; border: 2px solid #000; background: #F9F7F1; }
  .mega__promo-media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 2px solid #000; background: #fff; }
  .mega__promo-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mega__promo-body { display: grid; gap: .6rem; padding: 1.4rem; }
  .mega__promo-title { font-weight: 800; font-size: 1.6rem; }
  .mega__promo-text { font-size: 1.3rem; }
  .badge-3d { position: absolute; top: 1rem; left: 1rem; padding: .2rem .8rem; font-size: 1.1rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: #000; border: 2px solid #000; box-shadow: 3px 3px 0 #000; border-radius: 0; }
  .badge--cyan { background: #27D6FF; } .badge--yellow { background: #FFF915; } .badge--magenta { background: #F962DD; }
  .cta-3d { justify-self: start; display: inline-block; margin-top: .6rem; padding: .8rem 1.4rem; font-weight: 800; font-size: 1.3rem; color: #fff; background: #000; border: 2px solid #000; box-shadow: 3px 3px 0 #27D6FF; border-radius: 0; }
  .mega__promo-card:hover .cta-3d { box-shadow: 5px 5px 0 #27D6FF; }
  .mega__trending { flex: 0 0 44rem; }
  .mega__trending-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; margin-top: 1.2rem; }
  /* Mobile drawer */
  .mobile-menu { list-style: none; padding: 0; margin: 0; display: block; font-size: 1.7rem; font-weight: 700; overflow-y: auto; }
  .mobile-menu a { text-decoration: none; color: inherit; }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu__item { border-bottom: 1px solid #E6E3DA; }
  .mobile-menu__l1, .mobile-menu__acc > summary { display: flex; justify-content: space-between; align-items: center; min-height: 5.2rem; padding: 0 2rem; cursor: pointer; list-style: none; }
  .mobile-menu__acc > summary::-webkit-details-marker { display: none; }
  .mobile-menu__l1 .icon { width: 1.6rem; height: 1.6rem; }
  .mobile-menu__acc[open] > summary { background: #F9F7F1; }
  .mobile-menu__pm::before { content: "+"; font-size: 2rem; font-weight: 500; }
  .mobile-menu__acc[open] > summary .mobile-menu__pm::before { content: "\2212"; }
  .mobile-menu__panel { padding: 1.2rem 2rem 2rem; font-size: 1.5rem; }
  .mobile-menu__l2 > li > a, .mobile-menu__acc--l2 > summary { min-height: 4.4rem; padding: 0; display: flex; align-items: center; font-weight: 600; }
  .mobile-menu__l3 { padding: 0 0 1rem 1.2rem !important; }
  .mobile-menu__l3 a, .mobile-menu__viewall { display: flex; align-items: center; min-height: 4.4rem; font-weight: 500; }
  .mobile-menu__viewall { font-weight: 700 !important; text-decoration: underline !important; text-underline-offset: 3px; }
  .mobile-showroom { display: block; }
  .mobile-showroom__chips { display: flex; gap: .8rem; overflow-x: auto; padding: .2rem 0 1.2rem .2rem; scrollbar-width: none; scroll-snap-type: x mandatory; -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); }
  .mobile-showroom__chips::-webkit-scrollbar { display: none; }
  .mobile-showroom__chips [role=tab] { scroll-snap-align: start; }
  .mobile-showroom__chips [role=tab] { flex: none; min-height: 4.4rem; padding: 0 1.4rem; font: inherit; font-size: 1.3rem; font-weight: 700; background: #fff; color: #000; border: 2px solid #000; border-radius: 0; cursor: pointer; white-space: nowrap; }
  .mobile-showroom__chips [aria-selected=true] { background: #000; color: #fff; }
  .mobile-showroom [role=tabpanel][hidden] { display: none; }
  .mobile-showroom__grid { display: grid !important; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .mobile-showroom__grid .mega__thumb-label { font-size: 1.2rem; overflow-wrap: normal; word-break: normal; hyphens: none; }
  .mobile-menu .mega__thumb { display: grid; gap: .6rem; text-align: center; }
  .mobile-menu .mega__thumb-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mega__promo--compact { margin-top: 1.6rem; }
  .mega__promo--compact .mega__promo-card { display: grid; grid-template-columns: 9.6rem 1fr; }
  .mega__promo--compact .mega__promo-media { aspect-ratio: 1; border-bottom: 0; border-right: 2px solid #000; }
  .mega__promo--compact .badge-3d { position: static; justify-self: start; }
  .mega__promo--compact .mega__promo-body { padding: 1rem; }
  @media (prefers-reduced-motion: reduce) { .header__link .icon { transition: none; } }
  @media (prefers-reduced-motion: no-preference) { .header__link .icon { transition: rotate .15s; } }
  @media (min-width: 990px) and (max-width: 1099px) { .header__menu { gap: 1.8rem; } .header__link { font-size: 1.4rem; } }
  .mobile-menu__footer { margin-top: auto; padding: 2rem; border-top: 1px solid rgb(var(--color-border)); display: grid; gap: 1.4rem; }
  .mobile-menu__footer a { display: flex; gap: 1rem; align-items: center; text-decoration: none; color: inherit; font-weight: 600; }
  .drawer--top .drawer__panel { left: 0; width: 100%; bottom: auto; max-height: 90vh; transform: translateY(-100%); }
  .search-panel__body { display: block; padding: 2rem; max-width: 90rem; margin: 0 auto; width: 100%; }
  .search-panel__body input[type=search] { font-size: 2rem; padding: 1.4rem 2rem; border-radius: 99px; }
  @media (min-width: 990px) {
    .header__main { grid-template-columns: auto minmax(0, 1fr) auto; gap: 3.2rem; min-height: 8rem; }
    .header__logo { justify-self: start; }
    .header__search { display: block; max-width: 64rem; width: 100%; }
    .header__search-toggle, .header__menu-toggle { display: none; }
    .header__action { display: inline-flex; }
    .header__nav { display: block; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "link_list", "id": "customer_account_menu", "label": "Customer account menu", "default": "customer-account-main-menu" },
    { "type": "text", "id": "highlight_item", "label": "Highlighted menu item", "info": "Exact title of a menu item to show in red, e.g. On Sale.", "default": "On Sale" },
    { "type": "checkbox", "id": "show_empty_highlight", "label": "Show highlighted item when empty", "info": "Deals/Sale: keep it in the menu even with 0 products.", "default": false },
    { "type": "checkbox", "id": "demo_tree", "label": "Preview planned menu", "info": "Preview only: renders the planned menu tree instead of the Main menu.", "default": false },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_categories", "label": "Show category select", "info": "Lists your product types.", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder", "default": "What do you want to print?" },
    { "type": "header", "content": "Store link" },
    { "type": "url", "id": "store_link", "label": "Link" },
    { "type": "text", "id": "store_label", "label": "Label", "default": "Find a store" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "mega_columns", "name": "Mega: columns + promo", "settings": [
      { "type": "text", "id": "menu_item", "label": "Menu item title (exact)", "info": "Must match a top-level menu item. If it does not match, the item falls back to a simple dropdown." },
      { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "default": 4, "label": "Link columns" },
      { "type": "checkbox", "id": "show_promo", "default": true, "label": "Show promo card" },
      { "type": "collection", "id": "promo_collection", "label": "Promo source collection", "info": "Uses custom.mega_* metafields. Defaults to the menu item's collection." },
      { "type": "product", "id": "promo_product_fallback", "label": "Fallback featured product" },
      { "type": "image_picker", "id": "promo_image_fallback", "label": "Fallback promo image" },
      { "type": "text", "id": "promo_badge_fallback", "default": "Premium", "label": "Fallback badge" },
      { "type": "select", "id": "promo_badge_color", "label": "Fallback badge color", "default": "yellow", "options": [ { "value": "cyan", "label": "Cyan" }, { "value": "yellow", "label": "Yellow" }, { "value": "magenta", "label": "Magenta" } ] },
      { "type": "text", "id": "promo_cta", "default": "Shop now", "label": "CTA label" },
      { "type": "text", "id": "promo_title_fallback", "label": "Fallback promo title", "info": "Shown when no promo product is live." },
      { "type": "text", "id": "promo_asset_fallback", "label": "Fallback theme asset file" },
      { "type": "url", "id": "promo_url_fallback", "label": "Fallback promo link" }
    ] },
    { "type": "mega_compact", "name": "Mega: compact + promo", "settings": [
      { "type": "text", "id": "menu_item", "label": "Menu item title (exact)" },
      { "type": "collection", "id": "promo_collection", "label": "Promo source collection" },
      { "type": "product", "id": "promo_product_fallback", "label": "Fallback featured product" },
      { "type": "image_picker", "id": "promo_image_fallback", "label": "Fallback promo image" },
      { "type": "text", "id": "promo_badge_fallback", "default": "New", "label": "Fallback badge" },
      { "type": "select", "id": "promo_badge_color", "label": "Fallback badge color", "default": "magenta", "options": [ { "value": "cyan", "label": "Cyan" }, { "value": "yellow", "label": "Yellow" }, { "value": "magenta", "label": "Magenta" } ] },
      { "type": "text", "id": "promo_cta", "default": "Shop now", "label": "CTA label" }
    ] },
    { "type": "mega_showroom", "name": "Mega: showroom", "settings": [
      { "type": "text", "id": "menu_item", "label": "Menu item title (exact)" },
      { "type": "range", "id": "thumbs_per_row", "min": 3, "max": 6, "step": 1, "default": 4, "label": "Thumbs per row" },
      { "type": "select", "id": "thumb_ratio", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "4:3" } ], "default": "1/1", "label": "Thumb ratio" },
      { "type": "checkbox", "id": "show_promo", "default": true, "label": "Promo per tab", "info": "From each tab collection's custom.mega_* metafields." },
      { "type": "product", "id": "promo_product_fallback", "label": "Fallback product (first tab)" },
      { "type": "image_picker", "id": "promo_image_fallback", "label": "Fallback promo image" },
      { "type": "text", "id": "promo_badge_fallback", "default": "Premium", "label": "Fallback badge" },
      { "type": "select", "id": "promo_badge_color", "label": "Fallback badge color", "default": "yellow", "options": [ { "value": "cyan", "label": "Cyan" }, { "value": "yellow", "label": "Yellow" }, { "value": "magenta", "label": "Magenta" } ] },
      { "type": "text", "id": "promo_cta", "default": "Shop now", "label": "CTA label" },
      { "type": "url", "id": "view_all_url", "label": "View all link" }
    ] },
    { "type": "mega_products", "name": "Mega: trending products", "settings": [
      { "type": "text", "id": "menu_item", "label": "Menu item title (exact)" },
      { "type": "collection", "id": "source_collection", "label": "Trending source", "info": "Uses custom.mega_trending_products, else the first products." },
      { "type": "range", "id": "limit", "min": 2, "max": 4, "step": 1, "default": 2, "label": "Products" },
      { "type": "text", "id": "heading", "default": "Trending in [menu]", "label": "Heading" }
    ] },
    { "type": "promo_card", "name": "Promo card override", "settings": [
      { "type": "text", "id": "menu_item", "label": "Attach to menu item" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "badge", "label": "Badge" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "url", "label": "Link" },
      { "type": "text", "id": "cta", "default": "Shop now", "label": "CTA label" }
    ] }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}

