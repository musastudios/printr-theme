<div class="section page-width color-{{ section.settings.color_scheme }}">
  {{ section.settings.custom_liquid }}
</div>
{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Add app snippets or other Liquid code to create advanced customizations." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Custom Liquid" }]
}
{% endschema %}
