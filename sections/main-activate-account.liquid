<div class="section page-width account-narrow">
  <div class="account-card crop">
    <h1 class="h2">{{ 'customer.activate.title' | t }}</h1>
    <p>{{ 'customer.activate.subtext' | t }}</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<div class="form-error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActPassword">{{ 'customer.login.password' | t }}</label><input type="password" id="ActPassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ActConfirm">{{ 'customer.activate.confirm' | t }}</label><input type="password" id="ActConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="button button--full">{{ 'customer.activate.submit' | t }}</button>
      <button class="button button--secondary button--full" name="decline">{{ 'customer.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
