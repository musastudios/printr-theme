<div class="section page-width account-narrow">
  <div class="account-card crop">
    <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
    <p>{{ 'customer.reset.subtext' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.login.password' | t }}</label><input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.activate.confirm' | t }}</label><input type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="button button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
