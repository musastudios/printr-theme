{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign has_art = false
  assign tier_radio = false
  assign show_from = false
  if product.selected_variant == blank
    assign show_from = true
  endif
  for b in section.blocks
    if b.type == 'artwork_uploader'
      assign has_art = true
    endif
    if b.type == 'tier_pricing'
      assign tier_radio = true
    endif
  endfor
  assign media_list = product.media
-%}
<div class="section product{% if tier_radio %} product--tier-radio{% endif %} color-{{ section.settings.color_scheme }}" data-selected-variant="{{ variant.id }}" data-product-handle="{{ product.handle }}">
  <div class="page-width product__grid">
    <div class="product__media" data-swap="media">
      {%- assign featured = variant.featured_media | default: product.featured_media -%}
      <div class="media crop product__main-media" style="--ratio: {{ featured.aspect_ratio | default: 1 }}">
        {%- if featured and featured.media_type != 'image' -%}
          {{ featured | media_tag: image_size: '1800x' }}
        {%- elsif featured -%}
          {{ featured | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 55vw, 100vw', preload: true, fetchpriority: 'high' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      {%- if media_list.size > 1 -%}
        <ul class="product__thumbs" role="list">
          {%- for media in media_list -%}
            {%- unless media.id == featured.id -%}
              <li class="media" style="--ratio: 1">
                {%- if media.media_type == 'image' -%}
                  {{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw' }}
                {%- else -%}
                  {{ media | media_tag: image_size: '900x' }}
                {%- endif -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'description', 'collapsible', 'tabs' -%}
            {%- continue -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              <h1 class="product__title h2">{{ product.title | escape }}</h1>
            </div>
          {%- when 'price' -%}
            <div class="product__price" data-swap="price" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: variant, show_from: show_from %}
              <small>{%- if cart.taxes_included -%}{{ 'products.product.tax_included' | t }} {% endif -%}{{ 'products.product.shipping_policy' | t }}</small>
            </div>
          {%- when 'sku' -%}
            <p class="product__sku" data-swap="sku" {{ block.shopify_attributes }}>{% if variant.sku != blank %}{{ 'products.product.sku' | t }}: {{ variant.sku }}{% endif %}</p>
          {%- when 'variant_picker' -%}
            <div {{ block.shopify_attributes }}>{% render 'variant-picker', product: product, section_id: section.id %}</div>
          {%- when 'tier_pricing' -%}
            <div {{ block.shopify_attributes }}>{% render 'tier-pricing', product: product, variant: variant %}</div>
          {%- when 'brochure_config' -%}
            <div {{ block.shopify_attributes }}>{% render 'brochure-configurator', product: product, section_id: section.id, block: block %}</div>
          {%- when 'buy_buttons' -%}
            <div id="BuyBlock-{{ section.id }}" {{ block.shopify_attributes }}>{% render 'product-buy', variant: variant, section_id: section.id, show_artwork: block.settings.show_artwork, show_dynamic_checkout: block.settings.show_dynamic_checkout, custom_buy_now: has_art, inline_ctas: tier_radio %}</div>
          {%- when 'artwork_uploader' -%}
            <div {{ block.shopify_attributes }}>{% render 'artwork-uploader', product: product, section_id: section.id, block: block %}</div>
          {%- when 'design_service' -%}
            <div {{ block.shopify_attributes }}>{% render 'design-service', product: product, section_id: section.id, block: block %}</div>
          {%- when 'turnaround' -%}
            <p class="product__turnaround" {{ block.shopify_attributes }}>{% render 'icon', name: 'clock' %}<span><strong>{{ 'products.product.turnaround' | t }}:</strong> {{ product.metafields.custom.turnaround | default: block.settings.text }}</span></p>
          {%- when 'actions' -%}
            <div class="product__actions" {{ block.shopify_attributes }}>
              {%- if settings.enable_wishlist -%}<button type="button" class="link product__action" data-wishlist-toggle="{{ product.handle }}" aria-pressed="false">{% render 'icon', name: 'heart' %}{{ 'products.wishlist.save' | t }}</button>{%- endif -%}
              {%- if settings.enable_compare -%}<button type="button" class="link product__action" data-compare-toggle="{{ product.handle }}" aria-pressed="false">{% render 'icon', name: 'compare' %}{{ 'products.compare.label' | t }}</button>{%- endif -%}
              {% render 'product-share', product: product, section_id: section.id %}
            </div>
          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="product__details">
      {% render 'product-info-tabs', product: product, variant: variant, section: section %}
    </div>
  </div>
</div>
{%- if section.settings.sticky_buy and product.available -%}
  <sticky-buy class="sticky-buy color-{{ section.settings.color_scheme }}" data-watch="#BuyBlock-{{ section.id }}">
    <div class="page-width sticky-buy__inner">
      {%- if product.featured_media -%}<span class="sticky-buy__thumb">{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
      <span class="sticky-buy__title">{{ product.title | escape }}<span data-swap="price">{% render 'price', product: product, variant: variant, show_from: show_from %}</span></span>
      <button type="button" class="button">{{ 'products.product.add_to_cart' | t }}</button>
    </div>
  </sticky-buy>
{%- endif -%}
{% render 'product-json-ld', product: product %}
{% stylesheet %}
  .product__grid { display: grid; gap: clamp(3rem, 5vw, 7rem); }
  @media (min-width: 990px) { .product__grid { grid-template-columns: 1.2fr 1fr; grid-template-rows: auto 1fr; } .product__media { grid-column: 1; grid-row: 1; } .product__info { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: 10rem; align-self: start; } .product__details { grid-column: 1; grid-row: 2; align-self: start; } }
  .product__details { display: flex; flex-direction: column; gap: 2.4rem; min-width: 0; }
  .product__info { display: flex; flex-direction: column; gap: 2.4rem; }
  .section.product { padding-top: .8rem; padding-bottom: 6.4rem; }
  @media (max-width: 749px) { .section.product { padding-bottom: 4.8rem; } }
  .product__info .product__title { margin: 0; }
  .product__info > :has(.product__title) + .product__price, .product__info > .product__title + .product__price { margin-top: -0.8rem; }
  .product__thumbs { list-style: none; padding: 0; margin: 1.6rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .product__price .price { font-size: 2.6rem; }
  .product__turnaround { display: flex; gap: 1rem; align-items: center; margin: 0; padding: 1.2rem 1.6rem; background: rgba(var(--color-accent), .08); border-radius: var(--radius); }
  .product__accordion { border-top: 1px solid rgb(var(--color-border)); padding-block: 1.6rem; }
  .product__accordion summary { font-weight: 700; cursor: pointer; }
  .product__actions { display: flex; flex-wrap: wrap; gap: 2rem; }
  .product__action { display: inline-flex; align-items: center; gap: .6rem; }
  .product__action .icon { width: 1.8rem; }
  .product__action[aria-pressed="true"] { color: var(--m); }
  .product__action[aria-pressed="true"] .icon-heart { fill: currentColor; }
  .product__tabs .tabs__list { display: flex; gap: 2.4rem; border-bottom: 1px solid rgb(var(--color-border)); overflow-x: auto; }
  .product__tabs [role="tab"] { background: none; border: 0; padding: 1.2rem 0; font: inherit; font-weight: 600; color: inherit; cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .product__tabs [aria-selected="true"] { border-color: var(--m); }
  .product__tabs [role="tabpanel"] { padding-top: 1.6rem; }
  .sticky-buy { position: fixed; inset: auto 0 0; z-index: 30; border-top: 1px solid rgb(var(--color-border)); translate: 0 110%; transition: translate .35s cubic-bezier(.2,.7,.2,1); }
  .sticky-buy[visible] { translate: 0; }
  .sticky-buy__inner { display: flex; align-items: center; gap: 1.6rem; padding-block: 1rem; }
  .sticky-buy__thumb { width: 4.8rem; flex: none; }
  .sticky-buy__title { flex: 1; display: grid; font-weight: 600; font-size: 1.4rem; min-width: 0; }
  body:has(compare-bar:not([hidden])) .sticky-buy { bottom: 4.8rem; }
  [aria-busy=true] { opacity: .6; transition: opacity .2s; }
  .product--tier-radio .product-buy__submit, .product--tier-radio .product-buy__now, .product--tier-radio .sticky-buy .button { --cta-fill: #67D3FB; display: flex; justify-content: center; align-items: center; background: var(--cta-fill); color: #000; border: 2px solid #000; border-radius: 999px; box-shadow: 3px 3px 0 #000; font-family: var(--font-heading-family); font-weight: 700; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; cursor: pointer; transition: transform .12s, box-shadow .12s; }
  .product--tier-radio .product-buy__now { --cta-fill: #FEF956; }
  .product--tier-radio .product-buy__submit:hover, .product--tier-radio .product-buy__now:hover, .product--tier-radio .sticky-buy .button:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
  .product--tier-radio .product-buy__submit:focus-visible, .product--tier-radio .product-buy__now:focus-visible { outline: 2px solid #000; outline-offset: 3px; }
  .product--tier-radio .product-buy__submit:is([disabled], [aria-disabled="true"]), .product--tier-radio .product-buy__now:is([disabled], [aria-disabled="true"]), .product--tier-radio .product-buy__submit:is([disabled], [aria-disabled="true"]):hover, .product--tier-radio .product-buy__now:is([disabled], [aria-disabled="true"]):hover { background: #E8E5DE; color: #5E5E5E; border-color: #BDB8AD; box-shadow: none; transform: none; cursor: not-allowed; opacity: 1; }
  @media (max-width: 749px) { .product--tier-radio .product-buy__submit, .product--tier-radio .product-buy__now { width: 100%; white-space: normal; } }
  @media (prefers-reduced-motion: reduce) { .product--tier-radio .product-buy__submit, .product--tier-radio .product-buy__now, .product--tier-radio .sticky-buy .button { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "sticky_buy", "label": "Show sticky add-to-cart bar", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "sku", "name": "SKU", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "tier_pricing", "name": "Quantity tier pricing", "limit": 1 },
    { "type": "brochure_config", "name": "Brochure configurator", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Step-by-step options with live quantity pricing. Reads JSON from the product metafield custom.configurator, else the theme asset brochure-configurator.json. Variants must use options Size | Qty | Config. Place above Artwork uploader and Buy buttons; hide the Variant picker and Quantity tier pricing blocks on this template." },
      { "type": "url", "id": "quote_url", "label": "Quote request link", "info": "Shown when the chosen combination has no sellable variant. Defaults to /pages/contact." },
      { "type": "product", "id": "sample_product", "label": "Job sample product ($9.99)", "info": "Hidden product added to the cart when the customer ticks Job sample. If empty, the request is saved as a line property to invoice." },
      { "type": "product", "id": "qa_product", "label": "Pre-flight & QA product ($5)", "info": "Used for Digital proof when the Artwork uploader block has no QA product. If empty, the request is saved as a line property to invoice." }
    ] },
    { "type": "turnaround", "name": "Production time", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Default production time", "default": "5–7 business days" }] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_artwork", "label": "Show artwork notes field", "default": true },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }
    ] },
    { "type": "artwork_uploader", "name": "Artwork uploader", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Gates Add to cart and Buy it now until artwork passes preflight or the customer chooses to send it later, plus the artwork terms checkbox. Place above Buy buttons. Product metafields custom.A variant print_spec metaobject (custom.print_spec), then product metafields custom.trim_width_in, trim_height_in, bleed_in, safe_in, min_dpi and sides, override these defaults; otherwise trim size is parsed from the variant Size option." },
      { "type": "select", "id": "sides", "label": "Sides", "options": [{ "value": "1", "label": "1 (front only)" }, { "value": "2", "label": "2 (front and back)" }], "default": "1" },
      { "type": "select", "id": "bleed_in", "label": "Bleed", "options": [{ "value": "0", "label": "0\"" }, { "value": "0.0625", "label": "1/16\"" }, { "value": "0.125", "label": "1/8\" (0.125)" }, { "value": "0.25", "label": "1/4\"" }], "default": "0.125" },
      { "type": "select", "id": "safe_in", "label": "Safe margin", "options": [{ "value": "0", "label": "0\"" }, { "value": "0.0625", "label": "1/16\"" }, { "value": "0.125", "label": "1/8\" (0.125)" }, { "value": "0.25", "label": "1/4\"" }], "default": "0.125" },
      { "type": "range", "id": "max_mb", "label": "Max file size", "min": 1, "max": 20, "step": 1, "unit": "MB", "default": 20, "info": "Shopify's native line item file upload rejects files over 20 MB." },
      { "type": "product", "id": "qa_product", "label": "Pre-flight & QA fee product", "info": "Hidden $5 product added alongside the item when the customer opts in. Leave empty to hide the option." },
      { "type": "text", "id": "terms_url", "label": "Artwork terms URL", "info": "Overrides Theme settings → Artwork uploads." }
    ] },
    { "type": "design_service", "name": "Design service", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Place directly above Buy buttons. Tiers come from the hidden Design Service product's variants (SKUs DS-TOUCHUP, DS-REFRESH, DS-FRESH, else first 3 variants in order). Hidden on gift cards and on the Design Service product itself." },
      { "type": "product", "id": "ds_product", "label": "Design Service product", "info": "Hidden product with 3 tier variants. Leave empty to hide the callout." },
      { "type": "checkbox", "id": "hide_qa", "label": "Hide QA fee with a paid tier", "default": true, "info": "Recommended: Touch-Up and above include pre-flight QA, so the $5 Pre-flight & QA add-on is hidden and not added." },
      { "type": "text", "id": "quote_url", "label": "Quote link", "default": "/pages/design-services", "info": "[Unconfirmed] Page with the quote form; ?product=<handle>#quote is appended." }
    ] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "pickup", "name": "Pickup availability", "limit": 1 },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Add app snippets or other code." }] },
    { "type": "actions", "name": "Compare and share", "limit": 1 },
    { "type": "tabs", "name": "Tabs", "settings": [
      { "type": "text", "id": "tab_1", "label": "Tab 1 heading", "default": "Details" },
      { "type": "checkbox", "id": "tab_1_use_description", "label": "Tab 1 uses product description", "default": true },
      { "type": "richtext", "id": "tab_1_content", "label": "Tab 1 content" },
      { "type": "text", "id": "tab_2", "label": "Tab 2 heading", "default": "Artwork setup" },
      { "type": "richtext", "id": "tab_2_content", "label": "Tab 2 content", "default": "<p>Send a print-ready PDF at 300 dpi in CMYK with 0.125\" bleed. Keep text 0.125\" inside the trim line.</p>" },
      { "type": "text", "id": "tab_3", "label": "Tab 3 heading", "default": "Shipping" },
      { "type": "richtext", "id": "tab_3_content", "label": "Tab 3 content", "default": "<p>Orders ship after production. Tracking is emailed as soon as your job leaves the press.</p>" }
    ] },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Paper & finish specs" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "page", "id": "page", "label": "Content from page" }
    ] }
  ]
}
{% endschema %}



