<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h2 data-reveal>{{ section.settings.heading | escape }}</h2>
    <tabs-component>
      <div class="tabs__list" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.collection.title | default: block.settings.label }}</button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        <div role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
          <ul class="grid product-grid" role="list" style="--cols: 4">
            {%- for product in block.settings.collection.products limit: 8 -%}
              <li>{% render 'product-card', product: product %}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </tabs-component>
  </div>
</div>
{% stylesheet %}
  .tabs__list { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .tabs__list [role=tab] { border: 1px solid rgb(var(--color-foreground)); background: transparent; color: inherit; border-radius: 99px; padding: 1rem 2.2rem; font: 600 1.5rem var(--font-body-family); cursor: pointer; }
  .tabs__list [aria-selected=true] { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }
{% endstylesheet %}
{% schema %}
{
  "name": "Collection tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our print range" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [{ "type": "tab", "name": "Tab", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Tab" }, { "type": "collection", "id": "collection", "label": "Collection" }] }],
  "presets": [{ "name": "Collection tabs", "blocks": [{ "type": "tab" }, { "type": "tab" }] }]
}
{% endschema %}
