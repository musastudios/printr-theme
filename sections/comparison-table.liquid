{%- comment -%}Quick comparison table (e.g. paper stocks or finishes) built from blocks.{%- endcomment -%}
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-head"><span class="slug">{{ section.settings.slug | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>
    {%- assign cols = section.settings.columns | split: '|' -%}
    <div class="qct" role="region" aria-label="{{ section.settings.heading | escape }}" tabindex="0">
      <table>
        <thead><tr><td></td>{%- for c in cols -%}<th scope="col">{{ c | strip | escape }}</th>{%- endfor -%}</tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign vals = block.settings.values | split: '|' -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              {%- for c in cols -%}
                {%- assign v = vals[forloop.index0] | strip -%}
                <td>
                  {%- if v == 'yes' or v == 'sí' or v == 'si' -%}{% render 'icon', name: 'check' %}<span class="visually-hidden">{{ 'general.yes' | t }}</span>
                  {%- elsif v == 'no' or v == '' -%}<span aria-hidden="true">—</span><span class="visually-hidden">{{ 'general.no' | t }}</span>
                  {%- else -%}{{ v | escape }}{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% stylesheet %}
  .qct { overflow-x: auto; border: 1px solid rgb(var(--color-border)); border-radius: var(--radius); }
  .qct table { width: 100%; border-collapse: collapse; min-width: 56rem; }
  .qct th, .qct td { padding: 1.4rem 1.6rem; border-bottom: 1px solid rgb(var(--color-border)); text-align: center; }
  .qct tbody th { text-align: left; font-weight: 600; }
  .qct thead th { font-family: var(--font-heading-family); font-size: 1.8rem; }
  .qct thead th:nth-child(2) { box-shadow: inset 0 4px 0 var(--c); }
  .qct thead th:nth-child(3) { box-shadow: inset 0 4px 0 var(--m); }
  .qct thead th:nth-child(4) { box-shadow: inset 0 4px 0 var(--y); }
  .qct thead th:nth-child(5) { box-shadow: inset 0 4px 0 var(--k); }
  .qct td .icon { width: 2rem; margin-inline: auto; color: var(--m); }
  .qct tbody tr:hover { background: rgba(var(--color-foreground), .03); }
{% endstylesheet %}
{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "slug", "label": "Eyebrow", "default": "Paper guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which stock is right for you?" },
    { "type": "text", "id": "columns", "label": "Columns (separate with |)", "default": "Standard 14pt | Premium 16pt | Soft-touch 18pt | Kraft" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [{ "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Feature" },
    { "type": "text", "id": "values", "label": "Values (separate with |, use yes/no for icons)", "default": "yes | yes | yes | no" }
  ] }],
  "presets": [{ "name": "Comparison table", "blocks": [
    { "type": "row", "settings": { "label": "Thickness", "values": "Regular | Thick | Extra thick | Thick" } },
    { "type": "row", "settings": { "label": "Write-on surface", "values": "yes | yes | no | yes" } },
    { "type": "row", "settings": { "label": "Spot UV compatible", "values": "no | yes | yes | no" } },
    { "type": "row", "settings": { "label": "Recycled fibers", "values": "no | no | no | yes" } }
  ] }]
}
{% endschema %}
