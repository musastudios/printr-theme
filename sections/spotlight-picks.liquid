<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width spotlight">
    <div class="spotlight__intro">
      <span class="slug">{{ section.settings.slug | escape }}</span>
      <h2>{{ section.settings.heading | escape }}</h2>
      <ol class="spotlight__list" role="list">
        .spotlight:has(.spotlight__item:nth-child(1) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(1) :is(:hover, :focus-visible)) .spotlight__img:nth-child(1) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(2) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(2) :is(:hover, :focus-visible)) .spotlight__img:nth-child(2) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(3) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(3) :is(:hover, :focus-visible)) .spotlight__img:nth-child(3) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(4) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(4) :is(:hover, :focus-visible)) .spotlight__img:nth-child(4) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(5) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(5) :is(:hover, :focus-visible)) .spotlight__img:nth-child(5) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(6) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(6) :is(:hover, :focus-visible)) .spotlight__img:nth-child(6) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(7) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(7) :is(:hover, :focus-visible)) .spotlight__img:nth-child(7) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(8) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(8) :is(:hover, :focus-visible)) .spotlight__img:nth-child(8) { opacity: 1; scale: 1; }
      </ol>
    </div>
    <div class="spotlight__stage media crop" aria-hidden="true">
      .spotlight:has(.spotlight__item:nth-child(1) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(1) :is(:hover, :focus-visible)) .spotlight__img:nth-child(1) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(2) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(2) :is(:hover, :focus-visible)) .spotlight__img:nth-child(2) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(3) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(3) :is(:hover, :focus-visible)) .spotlight__img:nth-child(3) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(4) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(4) :is(:hover, :focus-visible)) .spotlight__img:nth-child(4) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(5) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(5) :is(:hover, :focus-visible)) .spotlight__img:nth-child(5) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(6) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(6) :is(:hover, :focus-visible)) .spotlight__img:nth-child(6) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(7) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(7) :is(:hover, :focus-visible)) .spotlight__img:nth-child(7) { opacity: 1; scale: 1; }
  .spotlight:has(.spotlight__item:nth-child(8) :is(:hover, :focus-visible)) .spotlight__img { opacity: 0; }
  .spotlight:has(.spotlight__item:nth-child(8) :is(:hover, :focus-visible)) .spotlight__img:nth-child(8) { opacity: 1; scale: 1; }
