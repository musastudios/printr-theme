{{ 'section-spotlight.css' | asset_url | stylesheet_tag }}
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width spotlight" id="Spotlight-{{ section.id }}">
    <div class="spotlight__intro">
      {%- if section.settings.slug != blank -%}<span class="slug">{{ section.settings.slug | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <ol class="spotlight__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <li class="spotlight__item" {{ block.shopify_attributes }}>
            <a class="spotlight__link" href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}">
              <span class="spotlight__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="spotlight__title">{{ block.settings.title | default: p.title | default: 'Product' | escape }}</span>
              {%- if p != blank -%}<span class="spotlight__price">{{ p.price | money }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="spotlight__stage media crop" aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image | default: block.settings.product.featured_media.preview_image -%}
        <div class="spotlight__img">
          {%- if img != blank -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
          {%- else -%}
            {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Spotlight picks",
  "settings": [
    { "type": "text", "id": "slug", "label": "Eyebrow", "default": "Spotlight" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Paper picks of the month" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "pick", "name": "Pick", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "title", "label": "Title override" },
      { "type": "image_picker", "id": "image", "label": "Image override" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Spotlight picks", "blocks": [{ "type": "pick", "settings": { "title": "Soft-touch cards" } }, { "type": "pick", "settings": { "title": "Kraft postcards" } }, { "type": "pick", "settings": { "title": "Feather flags" } }] }]
}
{% endschema %}

