{%- if settings.enable_compare -%}
  {%- capture labels -%}{"price": {{ 'products.compare.price' | t | json }}, "availability": {{ 'products.compare.availability' | t | json }}, "type": {{ 'products.compare.type' | t | json }}, "turnaround": {{ 'products.product.turnaround' | t | json }}, "description": {{ 'products.compare.description' | t | json }}, "sku": {{ 'products.product.sku' | t | json }}}{%- endcapture -%}
  <compare-bar class="compare-bar color-{{ section.settings.color_scheme }}" hidden collapsed data-labels="{{ labels | escape }}">
    <div class="compare-bar__inner page-width" role="region" aria-label="{{ 'products.compare.title' | t }}">
      <button type="button" class="compare-bar__toggle" data-collapse><span class="slug">{{ 'products.compare.title' | t }}</span> <span data-compare-count class="count-pill"></span></button>
      <ul class="compare-bar__items" role="list" data-items></ul>
      <div class="compare-bar__actions">
        <button type="button" class="button" data-open>{{ 'products.compare.compare_now' | t }}</button>
        <button type="button" class="link" data-clear>{{ 'products.compare.clear' | t }}</button>
      </div>
    </div>
    <dialog class="modal compare-modal" aria-labelledby="CompareTitle">
      <div class="modal__inner">
        <div class="modal__header">
          <h2 id="CompareTitle" class="h3">{{ 'products.compare.title' | t }}</h2>
          <button type="button" class="icon-button" data-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
        </div>
        <p class="compare-modal__hint"><span class="diff-key" aria-hidden="true"></span>{{ 'products.compare.differences' | t }}</p>
        <div class="compare-modal__scroll" data-table tabindex="0" role="region" aria-label="{{ 'products.compare.title' | t }}"></div>
      </div>
    </dialog>
  </compare-bar>
{%- endif -%}
{% stylesheet %}
  .compare-bar { position: fixed; inset: auto 0 0; z-index: 40; border-top: 2px solid rgb(var(--color-foreground)); box-shadow: 0 -10px 30px rgba(0,0,0,.08); transition: translate .35s cubic-bezier(.2,.7,.2,1); }
  .compare-bar[hidden] { display: none; }
  .compare-bar[collapsed] { translate: 0 calc(100% - 4.8rem - env(safe-area-inset-bottom, 0px)); }
  .compare-bar__inner { display: grid; gap: 1.2rem; align-items: center; padding-block: 1.2rem calc(2rem + env(safe-area-inset-bottom, 0px)); max-height: calc(100vh - 6rem); max-height: calc(100dvh - 6rem); overflow-y: auto; }
  .compare-bar__toggle { background: none; border: 0; padding: 0; min-height: 3.2rem; display: flex; align-items: center; gap: .8rem; cursor: pointer; color: inherit; font: inherit; }
  .count-pill { min-width: 2.2rem; padding: 0 .6rem; border-radius: 99px; background: var(--m); color: #fff; font-size: 1.2rem; }
  .compare-bar__items { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1.2rem; list-style: none; margin: 0; padding: 0; align-items: center; }
  .compare-bar__item { position: relative; display: flex; gap: .8rem; align-items: center; font-size: 1.3rem; line-height: 1.3; min-width: 0; }
  .compare-bar__item a { display: flex; gap: 1rem; align-items: center; text-decoration: none; min-width: 0; flex: 1 1 auto; }
  .compare-bar__item .media { width: 4.8rem; flex: none; }
  .compare-bar__item strong { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; text-overflow: ellipsis; word-break: break-word; min-width: 0; }
  .compare-bar__item .icon-button { flex: none; }
  .compare-bar__actions { display: flex; flex-wrap: wrap; gap: 1.2rem 2rem; align-items: center; }
  .compare-bar__actions .button { white-space: nowrap; }
  @media (min-width: 990px) {
    .compare-bar[collapsed] { translate: none; }
    .compare-bar__inner { grid-template-columns: auto minmax(0, 1fr) auto; gap: 2.4rem; padding-block: 1.6rem calc(2rem + env(safe-area-inset-bottom, 0px)); }
    .compare-bar__items { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .compare-modal__scroll { overflow: auto; max-height: 70vh; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; --label-w: 10.4rem; --col-w: 14rem; }
  .compare-table { border-collapse: separate; border-spacing: 0; table-layout: fixed; width: max(100%, calc(var(--label-w) + var(--cols, 2) * var(--col-w))); font-size: 1.4rem; }
  .compare-table__label-col { width: var(--label-w); }
  .compare-table th, .compare-table td { padding: 1.2rem; border-bottom: 1px solid rgb(var(--color-border)); text-align: left; vertical-align: top; overflow-wrap: anywhere; word-break: break-word; min-width: 0; }
  .compare-table thead th, .compare-table td { min-width: var(--col-w); }
  .compare-table .compare-product img { max-width: 100%; height: auto; }
  .compare-table tbody th, .compare-table .compare-table__corner { position: sticky; left: 0; z-index: 1; width: var(--label-w); min-width: var(--label-w); max-width: var(--label-w); background: rgb(var(--color-background)); font-weight: 600; white-space: normal; box-shadow: 1px 0 0 rgb(var(--color-border)); }
  .compare-table tr.is-diff td { background: rgba(255, 242, 0, .18); }
  @media (min-width: 750px) { .compare-modal__scroll { --label-w: 16rem; --col-w: 20rem; } }
  .diff-key { display: inline-block; width: 1.2rem; height: 1.2rem; background: rgba(255, 242, 0, .6); margin-right: .6rem; vertical-align: middle; }
{% endstylesheet %}
{% schema %}
{ "name": "Compare bar", "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }] }
{% endschema %}
