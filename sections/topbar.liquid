<div class="topbar color-{{ section.settings.color_scheme }}">
  <div class="page-width topbar__inner">
    <div class="topbar__col topbar__left">
      {%- if section.settings.menu != blank -%}
        <ul class="topbar__menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="topbar__col topbar__center">
      {%- if section.blocks.size > 0 -%}
        <div class="topbar__messages" data-rotate="{{ section.settings.rotate_speed }}">
          {%- for block in section.blocks -%}
            <p class="topbar__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
            </p>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="topbar__col topbar__right">
      {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'topbar__locale', id: 'TopbarCountry' -%}
          <label class="visually-hidden" for="TopbarCountrySelect">{{ 'accessibility.localization' | t }}</label>
          <select id="TopbarCountrySelect" name="country_code" onchange="this.form.submit()">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'topbar__locale', id: 'TopbarLanguage' -%}
          <label class="visually-hidden" for="TopbarLangSelect">{{ 'accessibility.localization' | t }}</label>
          <select id="TopbarLangSelect" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_social -%}
        <ul class="topbar__social" role="list">
          {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}<span class="visually-hidden">Facebook</span></a></li>{%- endif -%}
          {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}<span class="visually-hidden">TikTok</span></a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .topbar { font-size: 1.3rem; }
  .topbar__inner { display: grid; grid-template-columns: 1fr; align-items: center; min-height: 4rem; gap: 2rem; }
  .topbar__left, .topbar__right { display: none; }
  .topbar__center { text-align: center; font-weight: 600; }
  .topbar__menu, .topbar__social { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .topbar a { text-decoration: none; color: inherit; }
  .topbar__menu a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .topbar__messages { display: grid; }
  .topbar__msg { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transition: opacity .4s, visibility .4s; }
  .topbar__msg.is-active { opacity: 1; visibility: visible; }
  .topbar__right { justify-content: flex-end; align-items: center; gap: 1.6rem; }
  .topbar__social { gap: 1.2rem; }
  .topbar__social .icon { width: 1.6rem; height: 1.6rem; }
  .topbar__locale select { background: transparent; color: inherit; border: 0; padding: .4rem 2rem .4rem .4rem; width: auto; font: inherit; cursor: pointer; }
  .topbar__locale select option { color: #000; }
  @media (min-width: 990px) {
    .topbar__inner { grid-template-columns: 1fr auto 1fr; }
    .topbar__left, .topbar__right { display: flex; }
  }
{% endstylesheet %}
{% javascript %}
  document.querySelectorAll('.topbar__messages').forEach((el) => {
    const msgs = el.querySelectorAll('.topbar__msg');
    const s = Number(el.dataset.rotate) || 5;
    if (msgs.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    setInterval(() => {
      if (el.matches(':hover, :focus-within')) return;
      msgs[i].classList.remove('is-active');
      i = (i + 1) % msgs.length;
      msgs[i].classList.add('is-active');
    }, s * 1000);
  });
{% endjavascript %}
{% schema %}
{
  "name": "Top bar",
  "class": "section-topbar",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Utility menu" },
    { "type": "range", "id": "rotate_speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_country", "label": "Show country/currency selector", "default": true },
    { "type": "checkbox", "id": "show_language", "label": "Show language selector", "default": true },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $99" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Top bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
