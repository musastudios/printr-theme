<slide-show class="slideshow" data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% endif %}" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="slideshow__track" data-track>
    {% content_for 'blocks' %}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls page-width">
      <button type="button" class="icon-button" data-prev>{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden">{{ 'general.slider.previous' | t }}</span></button>
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}
          <button type="button" data-dot aria-label="{{ 'general.slider.go_to' | t: index: forloop.index }}"></button>
        {%- endfor -%}
      </div>
      <button type="button" class="icon-button" data-next>{% render 'icon', name: 'arrow-right' %}<span class="visually-hidden">{{ 'general.slider.next' | t }}</span></button>
    </div>
  {%- endif -%}
</slide-show>
{% stylesheet %}
  .slideshow { display: block; position: relative; }
  .slideshow__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .slideshow__track::-webkit-scrollbar { display: none; }
  .slideshow__controls { position: absolute; bottom: 2rem; left: 0; right: 0; display: flex; justify-content: flex-end; align-items: center; gap: 1rem; color: #fff; pointer-events: none; }
  .slideshow__controls > * { pointer-events: auto; }
  .slideshow__dots { display: flex; gap: .8rem; }
  .slideshow__dots button { width: 1.2rem; height: 1.2rem; border-radius: 50%; border: 2px solid #fff; background: transparent; padding: 0; cursor: pointer; }
  .slideshow__dots button[aria-current=true] { background: var(--y); border-color: var(--y); }
{% endstylesheet %}
{% schema %}
{
  "name": "Slideshow",
  "blocks": [{ "type": "slide" }],
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Featured promotions" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per slide", "min": 3, "max": 10, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Slideshow", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
