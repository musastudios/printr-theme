<div class="section page-width account-narrow">
  <div class="account-card crop">
    <div id="Recover" class="account-recover" tabindex="-1">
      <h1 class="h2">{{ 'customer.recover.title' | t }}</h1>
      <p>{{ 'customer.recover.subtext' | t }}</p>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}<p class="form-success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check' %}{{ 'customer.recover.success' | t }}</p>{%- endif -%}
        <div class="field">
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="RecoverEmail" name="email" autocomplete="email" required{% if form.errors %} aria-invalid="true" aria-describedby="RecoverError"{% endif %}>
          {%- if form.errors -%}<p id="RecoverError" class="form-error" role="alert">{{ form.errors.messages.form }}</p>{%- endif -%}
        </div>
        <button class="button">{{ 'customer.recover.submit' | t }}</button>
        <a class="link" href="#Login">{{ 'customer.recover.cancel' | t }}</a>
      {%- endform -%}
    </div>
    <div id="Login" class="account-login">
      <h1 class="h2">{{ 'customer.login.title' | t }}</h1>
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<div class="form-error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="LoginEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="LoginEmail" name="customer[email]" autocomplete="email" autocapitalize="off" required{% if form.errors contains 'form' %} aria-invalid="true"{% endif %}>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label for="LoginPassword">{{ 'customer.login.password' | t }}</label>
            <input type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required>
          </div>
          <a class="link" href="#Recover">{{ 'customer.login.forgot' | t }}</a>
        {%- endif -%}
        <button class="button button--full">{{ 'customer.login.submit' | t }}</button>
      {%- endform -%}
      <p class="account-switch">{{ 'customer.login.new' | t }} <a href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a></p>
      {%- if shop.checkout.guest_login -%}
        <hr>
        {%- form 'guest_login' -%}<button class="button button--secondary button--full">{{ 'customer.login.guest' | t }}</button>{%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{ "name": "Login", "settings": [] }
{% endschema %}
