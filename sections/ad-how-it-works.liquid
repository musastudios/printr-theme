{%- comment -%}
  Four-step "How it works" for ad landings. Defaults match the
  homepage process copy.
{%- endcomment -%}
<section class="section ahw color-{{ section.settings.color_scheme }}" aria-labelledby="AhwHeading-{{ section.id }}">
  <div class="page-width">
    <header class="ahw__head" data-reveal>
      {%- if section.settings.slug != blank -%}<p class="slug">{{ section.settings.slug | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="AhwHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 id="AhwHeading-{{ section.id }}" class="visually-hidden">{{ 'ad_landing.how_it_works.heading' | t }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="rte ahw__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>
    <ol class="ahw__steps" data-reveal>
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <li class="ahw__step" {{ block.shopify_attributes }}>
            <span class="ahw__num" aria-hidden="true">{{ '0' | append: forloop.index }}</span>
            {%- if block.settings.title != blank -%}<h3 class="ahw__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte ahw__text">{{ block.settings.text }}</div>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>
{% stylesheet %}
  .ahw__head { margin-bottom: 3.2rem; max-width: 56rem; }
  .ahw__head h2 { margin: 0; }
  .ahw__intro p { margin: .8rem 0 0; }
  .ahw__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
    counter-reset: none;
  }
  .ahw__step {
    display: grid;
    gap: .8rem;
    align-content: start;
    padding: 2rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--radius);
    background: rgba(var(--color-foreground), .03);
    height: 100%;
  }
  .ahw__num {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: .12em;
    color: rgb(var(--color-accent));
  }
  .ahw__title { margin: 0; font-size: 1.8rem; }
  .ahw__text p { margin: 0; font-size: 1.45rem; line-height: 1.5; opacity: .85; }
  @media (min-width: 750px) {
    .ahw__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  }
  @media (min-width: 1100px) {
    .ahw__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Ad how it works",
  "class": "section-ad-how-it-works",
  "settings": [
    { "type": "text", "id": "slug", "label": "Small label", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From file to door in four steps." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your product." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pick the size, paper and quantity.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ad how it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose your product.", "text": "<p>Pick the size, paper and quantity.</p>" } },
        { "type": "step", "settings": { "title": "Upload or get design help.", "text": "<p>Send your file, or let our designers help prepare it. They check bleed, resolution, and finish alignment before press.</p>" } },
        { "type": "step", "settings": { "title": "Review and approve.", "text": "<p>Check your order details and give the green light.</p>" } },
        { "type": "step", "settings": { "title": "We print and ship.", "text": "<p>Your order goes to press and ships to your door.</p>" } }
      ]
    }
  ]
}
{% endschema %}
