<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><span class="slug">{{ section.settings.slug | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="lookbook lookbook--{{ section.settings.layout }}">
      <div class="lookbook__stage media crop" style="--ratio: {{ section.settings.image.aspect_ratio | default: 1.5 }}">
        {%- if section.settings.image -%}
          {%- assign focal = section.settings.image.presentation.focal_point | prepend: 'object-position: ' -%}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 990px) 66vw, 100vw', style: focal }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- assign spot_title = p.title | default: forloop.index -%}
          <button type="button" class="hotspot" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%" popovertarget="Hotspot-{{ block.id }}" aria-label="{{ 'sections.lookbook.view' | t: title: spot_title | escape }}" {{ block.shopify_attributes }}>
            <span aria-hidden="true">{{ forloop.index }}</span>
          </button>
          <div id="Hotspot-{{ block.id }}" class="hotspot__card" popover style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%">
            {%- if p != blank -%}
              {% render 'product-card', product: p, compact: true, sizes: '24rem' %}
            {%- else -%}
              <p>{{ 'sections.lookbook.empty' | t }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.layout == 'list' -%}
        <ol class="lookbook__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              <li><span class="lookbook__num" aria-hidden="true">{{ forloop.index }}</span>{% render 'product-card', product: block.settings.product, compact: true, sizes: '12rem' %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .lookbook { display: grid; gap: 3.2rem; }
  @media (min-width: 990px) { .lookbook--list { grid-template-columns: 2fr 1fr; align-items: center; } }
  .lookbook__stage { position: relative; overflow: visible; }
  .hotspot { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; z-index: 4; width: 3.6rem; height: 3.6rem; border-radius: 50%; border: 2px solid #fff; background: var(--k); color: #fff; font-weight: 700; cursor: pointer; display: grid; place-items: center; box-shadow: 0 0 0 0 rgba(230, 0, 126, .6); animation: hotspot-pulse 2.4s infinite; }
  .hotspot:hover, .hotspot:focus-visible { background: var(--m); }
  @keyframes hotspot-pulse { 70% { box-shadow: 0 0 0 1.4rem rgba(230, 0, 126, 0); } 100% { box-shadow: 0 0 0 0 rgba(230, 0, 126, 0); } }
  .hotspot__card { width: min(26rem, 80vw); padding: 1.6rem; border: 1px solid rgb(var(--color-border)); border-radius: var(--radius); background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); box-shadow: 0 20px 40px rgba(0,0,0,.18); margin: auto; }
  .hotspot__card::backdrop { background: rgba(0,0,0,.15); }
  .lookbook__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6rem; }
  .lookbook__list li { display: grid; grid-template-columns: 3.2rem 1fr; gap: 1.2rem; align-items: center; }
  .lookbook__list .card { flex-direction: row; align-items: center; }
  .lookbook__list .card__media { flex: 0 0 9rem; }
  .lookbook__num { width: 3.2rem; height: 3.2rem; border-radius: 50%; background: var(--k); color: #fff; display: grid; place-items: center; font-weight: 700; }
{% endstylesheet %}
{% schema %}
{
  "name": "Lookbook (hotspots)",
  "settings": [
    { "type": "text", "id": "slug", "label": "Eyebrow", "default": "Shop the desk" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Branded from first hello" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "full", "label": "Image only" }, { "value": "list", "label": "Image with product list" }], "default": "list" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "hotspot", "name": "Hotspot", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "range", "id": "x", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "y", "label": "Vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Lookbook (hotspots)", "blocks": [
    { "type": "hotspot", "settings": { "x": 30, "y": 40 } }, { "type": "hotspot", "settings": { "x": 65, "y": 60 } }
  ] }]
}
{% endschema %}
