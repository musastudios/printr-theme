{%- liquid
  assign cols = section.settings.collections
-%}
<div class="section section--tight color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="circles__heading h4">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <ul class="circles" role="list">
      {%- if section.settings.show_sale and section.settings.sale_link != blank -%}
        <li class="circles__item">
          <a class="circles__link" href="{{ section.settings.sale_link }}">
            <span class="circles__thumb circles__thumb--sale"><span>{{ section.settings.sale_badge | default: 'Sale' | escape }}</span></span>
            <span class="circles__label">{{ section.settings.sale_label | escape }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if cols.size > 0 -%}
        {%- for collection in cols -%}
          <li class="circles__item">
            <a class="circles__link" href="{{ collection.url }}">
              <span class="circles__thumb">
                {%- assign img = collection.featured_image | default: collection.products.first.featured_media.preview_image -%}
                {%- if img != blank -%}
                  {{ img | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', width: 120, height: 120, alt: '' }}
                {%- else -%}
                  {%- assign n = forloop.index0 | modulo: 6 | plus: 1 -%}{{ 'collection-' | append: n | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </span>
              <span class="circles__label">{{ collection.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo = 'Business cards,Postcards,Flyers,Stickers,Banners,Flags,Apparel,Signs,Brochures' | split: ',' -%}
        {%- for title in demo -%}
          <li class="circles__item">
            <span class="circles__link">
              <span class="circles__thumb">{%- assign n = forloop.index0 | modulo: 6 | plus: 1 -%}{{ 'collection-' | append: n | placeholder_svg_tag: 'placeholder' }}</span>
              <span class="circles__label">{{ title }}</span>
            </span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>
{% stylesheet %}
  .section--tight { padding-block: 2.4rem; }
  .circles__heading { margin: 0 0 1.6rem; }
  .circles { display: flex; gap: clamp(1.6rem, 2.4vw, 3.2rem); list-style: none; margin: 0; padding: .4rem .2rem 1rem; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; }
  .circles__item { flex: 0 0 auto; scroll-snap-align: start; }
  .circles__link { display: grid; justify-items: center; gap: 1rem; text-decoration: none; color: inherit; width: clamp(7.2rem, 8vw, 10rem); text-align: center; }
  .circles__thumb { display: grid; place-items: center; width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: rgba(var(--color-foreground), .06); transition: box-shadow .25s, transform .25s; }
  .circles__thumb img, .circles__thumb svg { width: 100%; height: 100%; object-fit: cover; transition: scale .4s; }
  a.circles__link:hover .circles__thumb, a.circles__link:focus-visible .circles__thumb { box-shadow: 0 0 0 3px rgb(var(--color-background)), 0 0 0 5px var(--m); }
  a.circles__link:hover img { scale: 1.08; }
  .circles__thumb--sale { background: #D4145A; color: #fff; font-family: var(--font-heading-family); font-weight: 800; font-size: clamp(1.6rem, 1.6vw, 2rem); }
  .circles__label { font-size: 1.4rem; font-weight: 600; line-height: 1.25; }
  @media (prefers-reduced-motion: reduce) { .circles__thumb img { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Category circles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 16, "info": "Uses each collection image, or its first product image." },
    { "type": "header", "content": "Sale circle" },
    { "type": "checkbox", "id": "show_sale", "label": "Show sale circle", "default": true },
    { "type": "text", "id": "sale_badge", "label": "Circle text", "default": "Sale" },
    { "type": "text", "id": "sale_label", "label": "Label", "default": "Sale items" },
    { "type": "url", "id": "sale_link", "label": "Link", "default": "/collections/all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Category circles" }]
}
{% endschema %}

