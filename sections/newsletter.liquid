<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.bg_image != blank %} has-bg{% endif %}">
  {%- render 'section-bg', image: section.settings.bg_image, overlay: section.settings.bg_overlay -%}
  <div class="page-width newsletter" data-reveal>
    {%- if section.settings.heading != blank -%}<h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', id: 'NewsletterSection' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.email' | t }}</label>
        <div class="newsletter__field">
          <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}">
          <button type="submit" class="button">{{ 'general.newsletter.subscribe' | t }}</button>
        </div>
        <p class="newsletter__fine">{{ 'general.newsletter.fine_print' | t }}</p>
        {{ form.errors | default_errors }}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
{% stylesheet %}
  .newsletter { display: grid; justify-items: center; gap: 1.6rem; text-align: center; max-width: 72rem; }
  .newsletter__heading { margin: 0; }
  .newsletter .rte p { margin: 0; }
  .newsletter form { width: 100%; max-width: 52rem; }
  .newsletter__field { display: flex; gap: .8rem; flex-wrap: wrap; }
  .newsletter__field input { flex: 1 1 22rem; min-height: 4.8rem; padding: 0 1.6rem; border: 2px solid rgb(var(--color-foreground)); border-radius: var(--radius-button); background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); font: inherit; }
  .newsletter__fine { margin: .8rem 0 0; font-size: 1.3rem; opacity: .75; }
{% endstylesheet %}
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get print deals in your inbox" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New products, seasonal offers and file tips. No spam.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
