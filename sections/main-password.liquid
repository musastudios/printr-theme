<div class="section page-width" style="max-width: 50rem; text-align: center">
  {%- if settings.logo != blank -%}<h1>{{ settings.logo | image_url: width: 500 | image_tag: alt: shop.name, class: 'password__logo' }}</h1>{%- elsif settings.show_brand_logo -%}<h1>{% render 'printr-logo', uid: 'password', class: 'password__logo' %}</h1>{%- else -%}<h1>{{ shop.name }}</h1>{%- endif -%}
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="Password">{{ 'general.password.password' | t }}</label>
      <input type="password" name="password" id="Password" autocomplete="current-password">
    </div>
    <button type="submit" class="button">{{ 'general.password.submit' | t }}</button>
  {%- endform -%}
</div>
{% stylesheet %}
  .password__logo { width: min(28rem, 70vw); height: auto; display: block; margin-inline: auto; }
{% endstylesheet %}
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
