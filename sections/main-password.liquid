<div class="section page-width" style="max-width: 50rem; text-align: center">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="Password">{{ 'general.password.password' | t }}</label>
      <input type="password" name="password" id="Password" autocomplete="current-password">
    </div>
    <button type="submit" class="button">{{ 'general.password.submit' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
