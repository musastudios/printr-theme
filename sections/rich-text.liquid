<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.bg_image != blank %} has-bg{% endif %}">
  {%- render 'section-bg', image: section.settings.bg_image, overlay: section.settings.bg_overlay -%}
  <div class="page-width rich-text" data-reveal>
    {% content_for 'blocks' %}
  </div>
</div>
{% stylesheet %}
  .rich-text { display: flex; flex-direction: column; align-items: center; gap: 2rem; text-align: center; }
{% endstylesheet %}
{% schema %}
{
  "name": "Rich text",
  "blocks": [{ "type": "@theme" }],
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60, "info": "Uses the color scheme background. Raise for text contrast." }],
  "presets": [{ "name": "Rich text", "blocks": [{ "type": "heading", "settings": { "alignment": "center" } }, { "type": "text", "settings": { "alignment": "center" } }] }]
}
{% endschema %}
