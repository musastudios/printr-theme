{% doc %}
  Share button. Uses the native share sheet on touch devices, else an accessible dialog with WhatsApp, Facebook, X, Email and Copy link.
  @param {product} product - The product
  @param {string} section_id - Section id
  @example
  {% render 'product-share', product: product, section_id: section.id %}
{% enddoc %}
{%- liquid
  assign share_url = request.origin | append: product.url
  assign t_enc = product.title | url_encode
  assign u_enc = share_url | url_encode
  assign dlg = 'Share-' | append: section_id
-%}
<product-share class="pshare" data-url="{{ share_url | escape }}" data-title="{{ product.title | escape }}">
  <button type="button" class="link product__action pshare__open" aria-haspopup="dialog" aria-controls="{{ dlg }}" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
    {{- 'products.product.share' | t -}}
  </button>
  <div class="pshare__dialog" id="{{ dlg }}" role="dialog" aria-modal="true" aria-labelledby="{{ dlg }}-h" hidden>
    <div class="pshare__head">
      <h2 class="pshare__title" id="{{ dlg }}-h">{{ 'products.product.share_title' | t }}</h2>
      <button type="button" class="pshare__close" data-share-close aria-label="{{ 'general.close' | t }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
    </div>
    <ul class="pshare__list" role="list">
      <li><a class="pshare__opt" target="_blank" rel="noopener" href="https://wa.me/?text={{ t_enc }}%20{{ u_enc }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>WhatsApp</a></li>
      <li><a class="pshare__opt" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ u_enc }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>Facebook</a></li>
      <li><a class="pshare__opt" target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?text={{ t_enc }}&url={{ u_enc }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4l16 16"/><path d="M20 4 4 20"/></svg>X</a></li>
      <li><a class="pshare__opt" href="mailto:?subject={{ t_enc }}&body={{ u_enc }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>{{ 'products.product.share_email' | t }}</a></li>
      <li><button type="button" class="pshare__opt" data-share-copy><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>{{ 'products.product.share_copy' | t }}</button></li>
    </ul>
  </div>
  <p class="pshare__toast" role="status" aria-live="polite" data-share-toast hidden>{{ 'products.product.share_copied' | t }}</p>
</product-share>
{% stylesheet %}
  .pshare { position: relative; display: inline-block; }
  .pshare__dialog { position: absolute; z-index: 30; left: 0; top: calc(100% + .8rem); width: 28rem; background: #fff; color: #000; border: 2px solid #000; box-shadow: 3px 3px 0 #000; border-radius: 1.2rem; padding: 1.4rem; }
  .pshare__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .8rem; }
  .pshare__title { font-size: 1.5rem; margin: 0; font-weight: 700; }
  .pshare__close { background: none; border: 0; width: 3.6rem; height: 3.6rem; display: grid; place-items: center; cursor: pointer; color: #000; }
  .pshare__close svg, .pshare__opt svg { width: 2rem; height: 2rem; flex: none; }
  .pshare__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .pshare__opt { display: flex; align-items: center; gap: 1rem; width: 100%; min-height: 4.4rem; padding: 0 1.2rem; border: 2px solid #000; border-radius: .8rem; background: #fff; color: #000; font: inherit; font-weight: 600; font-size: 1.4rem; text-decoration: none; cursor: pointer; text-align: left; }
  .pshare__opt:hover { box-shadow: 3px 3px 0 #000; transform: translate(-1px, -1px); }
  .pshare__opt:focus-visible, .pshare__close:focus-visible { outline: 2px solid var(--m, #e6007e); outline-offset: 2px; }
  .pshare__toast { position: fixed; z-index: 60; left: 50%; bottom: 2.4rem; transform: translateX(-50%); background: #000; color: #fff; padding: 1rem 1.6rem; border-radius: .8rem; box-shadow: 3px 3px 0 #ffe600; font-weight: 600; margin: 0; }
  @media (max-width: 749px) {
    .pshare__dialog { position: fixed; left: 1.6rem; right: 1.6rem; top: auto; bottom: 1.6rem; width: auto; }
  }
{% endstylesheet %}
