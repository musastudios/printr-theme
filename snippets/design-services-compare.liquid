{% doc %}
  Before/after compare widget for the Design Services page (hero + showcase).
  Theme Editor image pickers win; otherwise a theme asset filename is used
  (ds-hero-*.webp, ds-ba-01-before.webp, etc.). Missing assets fall back to a labeled slot.
  @param {string} prefix - unique id prefix
  @param {object} [block] - case block with images and copy (showcase)
  @param {number} [default_pos] - divider from the left (38 shows ~62% after)
  @param {boolean} [ticket] - show the hero proof ticket
  @param {string} [aspect] - CSS aspect-ratio, "4 / 5" (hero) or "4 / 3" (showcase)
  @param {string} [loading] - img loading attribute, eager for the hero
  @param {object} [before_image] - optional section-level image picker (hero)
  @param {object} [after_image] - optional section-level image picker (hero)
  @param {string} [before_asset] - optional asset filename override (hero)
  @param {string} [after_asset] - optional asset filename override (hero)
{% enddoc %}
{%- liquid
  assign ratio = aspect | default: '4 / 3'
  assign load = loading | default: 'lazy'
  if ticket
    assign ckey = 'sable'
  elsif block
    assign ckey = block.settings.case_key | default: 'sable'
  else
    assign ckey = 'sable'
  endif
  assign cname = ''
  assign dim = ''
  assign before_alt = ''
  assign after_alt = ''
  if block
    assign cname = block.settings.title
    assign dim = block.settings.dimension
    assign before_alt = block.settings.before_alt
    assign after_alt = block.settings.after_alt
  endif
  if cname == blank
    assign cname_key = 'design_services_page.showcase.' | append: ckey | append: '_name'
    assign cname = cname_key | t
  endif
  if dim == blank
    assign dim_key = 'design_services_page.showcase.' | append: ckey | append: '_dimension'
    assign dim = dim_key | t
  endif
  if before_alt == blank
    assign before_alt_key = 'design_services_page.showcase.' | append: ckey | append: '_before_alt'
    assign before_alt = before_alt_key | t
  endif
  if after_alt == blank
    assign after_alt_key = 'design_services_page.showcase.' | append: ckey | append: '_after_alt'
    assign after_alt = after_alt_key | t
  endif
  assign before_img = before_image
  assign after_img = after_image
  if block and before_img == blank
    assign before_img = block.settings.before_image
  endif
  if block and after_img == blank
    assign after_img = block.settings.after_image
  endif
  assign before_file = before_asset
  assign after_file = after_asset
  if block and before_file == blank
    assign before_file = block.settings.before_asset
  endif
  if block and after_file == blank
    assign after_file = block.settings.after_asset
  endif
  if before_file == blank
    if ticket
      assign before_file = 'ds-hero-before.webp'
    else
      case ckey
        when 'alba'
          assign before_file = 'ds-ba-02-before.webp'
        when 'mira'
          assign before_file = 'ds-ba-03-before.webp'
        else
          assign before_file = 'ds-ba-01-before.webp'
      endcase
    endif
  endif
  if after_file == blank
    if ticket
      assign after_file = 'ds-hero-after.webp'
    else
      case ckey
        when 'alba'
          assign after_file = 'ds-ba-02-after.webp'
        when 'mira'
          assign after_file = 'ds-ba-03-after.webp'
        else
          assign after_file = 'ds-ba-01-after.webp'
      endcase
    endif
  endif
  assign pos = default_pos | default: 38
  if ratio == '4 / 5'
    assign img_w = 2400
    assign img_h = 3000
  else
    assign img_w = 3200
    assign img_h = 2400
  endif
-%}
<ds-compare
  class="dsp-compare"
  data-value="{{ pos }}"
  data-valuetext="{{ 'design_services_page.showcase.valuetext' | t | escape }}"
  style="--pos: {{ pos }}%; --dsp-ratio: {{ ratio }};"
>
  <div class="dsp-compare__shell crop">
    <div class="dsp-compare__frame">
      <div class="dsp-compare__layer dsp-compare__layer--after">
        {%- if after_img != blank -%}
          {{ after_img | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 42vw, 100vw', loading: load, alt: after_alt, class: 'dsp-compare__img' }}
        {%- else -%}
          <img
            class="dsp-compare__img"
            src="{{ after_file | asset_url }}"
            alt="{{ after_alt | escape }}"
            width="{{ img_w }}"
            height="{{ img_h }}"
            loading="{{ load }}"
            {% if load == 'eager' %}fetchpriority="high"{% endif %}
            decoding="async"
          >
        {%- endif -%}
        <div class="dsp-compare__ph" aria-hidden="true">
          <span class="dsp-compare__ph-label">{{ 'design_services_page.showcase.after' | t }}</span>
          <p>{{ cname | escape }}</p>
          <small>{{ 'design_services_page.showcase.placeholder' | t }}</small>
        </div>
      </div>
      <div class="dsp-compare__layer dsp-compare__layer--before">
        {%- if before_img != blank -%}
          {{ before_img | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 42vw, 100vw', loading: load, alt: before_alt, class: 'dsp-compare__img' }}
        {%- else -%}
          <img
            class="dsp-compare__img"
            src="{{ before_file | asset_url }}"
            alt="{{ before_alt | escape }}"
            width="{{ img_w }}"
            height="{{ img_h }}"
            loading="{{ load }}"
            {% if load == 'eager' %}fetchpriority="high"{% endif %}
            decoding="async"
          >
        {%- endif -%}
        <div class="dsp-compare__ph" aria-hidden="true">
          <span class="dsp-compare__ph-label">{{ 'design_services_page.showcase.before' | t }}</span>
          <p>{{ cname | escape }}</p>
          <small>{{ 'design_services_page.showcase.placeholder' | t }}</small>
        </div>
      </div>
      <div class="dsp-compare__rule" aria-hidden="true"><span class="dsp-compare__knob"></span></div>
      <input
        type="range"
        min="0"
        max="100"
        value="{{ pos }}"
        step="1"
        class="dsp-compare__range"
        id="ds-compare-{{ prefix | default: ckey }}"
        aria-label="{{ 'design_services_page.showcase.compare_label' | t | escape }}"
        aria-valuetext="{{ 'design_services_page.showcase.valuetext' | t | escape }}"
      >
    </div>
    {%- if ticket -%}
      <p class="dsp-proof__ticket">{{ 'design_services_page.hero.proof_ticket' | t }}</p>
      <span class="dsp-proof__reg" aria-hidden="true"></span>
    {%- endif -%}
  </div>
  <div class="dsp-compare__toggle" role="group" aria-label="{{ 'design_services_page.showcase.compare_label' | t | escape }}">
    <button type="button" class="dsp-compare__pill" data-ds-pos="100" aria-pressed="false">{{ 'design_services_page.showcase.before' | t }}</button>
    <button type="button" class="dsp-compare__pill" data-ds-pos="0" aria-pressed="false">{{ 'design_services_page.showcase.after' | t }}</button>
  </div>
  <p class="dsp-compare__dim">{{ dim | escape }}</p>
</ds-compare>
