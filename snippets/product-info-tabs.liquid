{% doc %}
  Left-column product info as rounded tabs: Details, Description, Specs, Templates.
  Details = Tabs block extra tabs + production time; Specs = Collapsible blocks.
  @param {product} product - Product
  @param {variant} variant - Selected variant
  @param {object} section - main-product section
{% enddoc %}
{%- liquid
  assign uid = 'PInfo-' | append: section.id
  assign names = 'details,description,specs,templates' | split: ','
-%}
<tabs-component class="pinfo">
  <div class="pinfo__list" role="tablist" aria-label="{{ 'products.info.tabs_label' | t }}">
    {%- for n in names -%}
      {%- capture key %}products.info.tab_{{ n }}{% endcapture -%}
      <button type="button" class="pinfo__tab" role="tab" id="{{ uid }}-t-{{ n }}" aria-controls="{{ uid }}-p-{{ n }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
        {%- case n -%}
          {%- when 'details' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          {%- when 'description' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          {%- when 'specs' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></svg>
          {%- else -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
        {%- endcase -%}
        <span>{{ key | t }}</span>
      </button>
    {%- endfor -%}
  </div>
  <div class="pinfo__card">
    <div class="pinfo__panel rte" role="tabpanel" tabindex="0" id="{{ uid }}-p-details" aria-labelledby="{{ uid }}-t-details">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tabs' -%}
          <div {{ block.shopify_attributes }}>
            {%- for n in (1..3) -%}
              {%- capture hkey %}tab_{{ n }}{% endcapture -%}
              {%- capture ckey %}tab_{{ n }}_content{% endcapture -%}
              {%- if n == 1 and block.settings.tab_1_use_description -%}{%- continue -%}{%- endif -%}
              {%- if block.settings[hkey] != blank and block.settings[ckey] != blank -%}
                <h3 class="pinfo__h">{{ block.settings[hkey] | escape }}</h3>
                {{ block.settings[ckey] }}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if product.metafields.custom.turnaround != blank -%}
        <p><strong>{{ 'products.product.turnaround' | t }}:</strong> {{ product.metafields.custom.turnaround }}</p>
      {%- endif -%}
    </div>
    <div class="pinfo__panel rte" role="tabpanel" tabindex="0" id="{{ uid }}-p-description" aria-labelledby="{{ uid }}-t-description" hidden>
      {%- for block in section.blocks -%}
        {%- if block.type == 'description' -%}<div {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}
      {%- endfor -%}
    </div>
    <div class="pinfo__panel rte" role="tabpanel" tabindex="0" id="{{ uid }}-p-specs" aria-labelledby="{{ uid }}-t-specs" hidden>
      {%- for block in section.blocks -%}
        {%- if block.type == 'collapsible' -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="pinfo__h">{{ block.settings.heading | escape }}</h3>
            {{ block.settings.content }}{{ block.settings.page.content }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="pinfo__panel" role="tabpanel" tabindex="0" id="{{ uid }}-p-templates" aria-labelledby="{{ uid }}-t-templates" hidden>
      <p>{{ 'products.info.templates_intro' | t }}</p>
      {% render 'product-templates', product: product, variant: variant %}
    </div>
  </div>
</tabs-component>
{% stylesheet %}
  .pinfo__list { display: flex; flex-wrap: wrap; gap: .8rem; margin-bottom: 1.2rem; }
  .pinfo__tab { display: inline-flex; align-items: center; gap: .6rem; padding: .8rem 1.6rem; font: inherit; font-weight: 700; color: #000; background: #FAF8F3; border: 2px solid #000; border-radius: 999px; box-shadow: 3px 3px 0 #000; cursor: pointer; transition: transform .12s, box-shadow .12s; }
  .pinfo__tab svg { width: 1.8rem; height: 1.8rem; flex: none; }
  .pinfo__tab:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
  .pinfo__tab[aria-selected="true"] { background: #F3E7EA; }
  .pinfo__tab:focus-visible, .pinfo__panel:focus-visible { outline: 2px solid #000; outline-offset: 3px; }
  .pinfo__card { background: #FAF8F3; border: 2px solid #000; border-radius: 1.6rem; box-shadow: 3px 3px 0 #000; padding: 2rem 2.4rem; color: #000; }
  .pinfo__h { font-size: 1.6rem; margin: 1.6rem 0 .6rem; }
  .pinfo__panel > :first-child, .pinfo__panel > div:first-child > .pinfo__h:first-child { margin-top: 0; }
  .product__tpl { display: inline-flex; align-items: center; gap: .8rem; font-weight: 700; }
  .product__tpl svg { width: 1.8rem; height: 1.8rem; }
  @media (prefers-reduced-motion: reduce) { .pinfo__tab { transition: none; } }
{% endstylesheet %}
