{% doc %}
  Inline SVG icon.
  @param {string} name - Icon name: search, cart, account, menu, close, arrow-left, arrow-right, chevron-down, facebook, instagram, tiktok, plus, minus, check, truck, print, clock, chat, heart, compare, grid, list, pin, store, eye, arrow-up, mail, lock, sparkle
  @example
  {% render 'icon', name: 'cart' %}
{% enddoc %}
<svg class="icon icon-{{ name }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
    {%- when 'cart' -%}<path d="M5 7h14l-1.5 12h-11z"/><path d="M9 7a3 3 0 0 1 6 0"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'menu' -%}<path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'arrow-left' -%}<path d="M15 5l-7 7 7 7"/>
    {%- when 'arrow-right' -%}<path d="M9 5l7 7-7 7"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'check' -%}<path d="m5 12 5 5 9-10"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'print' -%}<path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'chat' -%}<path d="M4 5h16v11H8l-4 4z"/>
