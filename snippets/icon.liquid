    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {%- when 'sparkle' -%}<path d="M12 3v6M12 15v6M3 12h6M15 12h6"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
