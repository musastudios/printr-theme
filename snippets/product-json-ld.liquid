{%- comment -%} Product JSON-LD with PRINTR as brand (never the store vendor). {%- endcomment -%}
{%- liquid
  assign v0 = product.selected_or_first_available_variant
  assign img = product.featured_media | image_url: width: 1200
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media %}"image": [{{ 'https:' | append: img | json }}],{% endif %}
    "description": {{ product.description | replace: 'Caguas Copy', 'PRINTR' | strip_html | strip_newlines | truncate: 500 | json }},
    {%- if v0.sku != blank %}"sku": {{ v0.sku | json }},{% endif %}
    "brand": { "@type": "Brand", "name": "PRINTR" },
    "offers": [
      {%- for v in product.variants limit: 100 -%}
        {
          "@type": "Offer",
          "url": {{ request.origin | append: v.url | json }},
          {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "seller": { "@type": "Organization", "name": "PRINTR" }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
