{% doc %}
  Production time block. Two data sources, in this order:
  1) Legacy per-variant surcharges (variant metafields printr.rush_2bd / printr.rush_nbd, store-currency amounts already
     marked up; blank = not offered): Standard (included) / 2 Business Days / Next Business Day, charged per unit.
  2) Product metafield printr.turnaround (JSON, see docs/turnaround.md): an included default tier (2nd Day where it exists,
     else the real minimum, e.g. 4 business days) plus optional paid tiers (Next Day +$5, a flat fee per cart line).
     With one tier left after the per-spec conditions, a plain "Production time: N business days" line is shown instead.
  3) If that metafield is blank, a theme-side fallback (snippets/turnaround-theme-config.liquid, sourced from
     assets/turnaround-config.json) applies the same rules so the selector works before any store metafield is written.
     Next Day +$5 is only listed on verified families; unverified products show their real production time and no Next Day.
  A paid tier is charged as a nested cart line of the hidden Rush Production fee product, added in the same /cart/add call
  as the print item (see assets/rush-turnaround.js and docs/rush-turnaround.md). Preferred fee variant is RUSH-NBD-FLAT at
  $5.00 (qty 1); if it does not exist, the existing $0.01 RUSH-NBD variant is used at quantity 500. Without a usable fee
  variant, paid tiers are hidden. With no metafield and no theme fallback, the static production-time note
  (custom.turnaround / block setting) is shown, or nothing when that text is blank.
  @param {product} product - The product
  @param {variant} variant - The selected variant
  @param {string} section_id - Section id
  @param {object} block - The turnaround block (settings.text = default production time)
  @example
  {% render 'rush-turnaround', product: product, variant: variant, section_id: section.id, block: block %}
{% enddoc %}
{%- liquid
  assign rush_product = settings.rush_product
  if rush_product == blank
    assign rush_product = all_products['rush-production']
  endif
  assign fee_2bd = nil
  assign fee_nbd = nil
  assign fee_any = nil
  assign flat_2bd = nil
  assign flat_nbd = nil
  if rush_product != blank and rush_product.id != blank
    for fv in rush_product.variants
      if fv.available
        assign fsku = fv.sku | upcase
        if fsku == 'RUSH-2BD-FLAT'
          assign flat_2bd = fv
        elsif fsku == 'RUSH-NBD-FLAT'
          assign flat_nbd = fv
        elsif fv.price == 1
          if fsku == 'RUSH-2BD'
            assign fee_2bd = fv
          elsif fsku == 'RUSH-NBD'
            assign fee_nbd = fv
          elsif fee_any == nil
            assign fee_any = fv
          endif
        endif
      endif
    endfor
  endif
  if fee_2bd == nil
    assign fee_2bd = fee_any
  endif
  if fee_nbd == nil
    assign fee_nbd = fee_any
  endif

  assign std_days = variant.metafields.printr.standard_days.value | default: settings.rush_standard_days | default: 4

  comment
    Tier lists are built as parallel comma lists (key, business days, fee in cents, fee variant id, fee units, flat).
    mode "variant": legacy per-variant surcharges (printr.rush_2bd / rush_nbd), charged per unit.
    mode "product": product metafield printr.turnaround (tiers, flat fee per cart line).
  endcomment
  assign mode = 'none'
  assign l_key = ''
  assign l_days = ''
  assign l_cents = ''
  assign l_fee = ''
  assign l_units = ''
  assign l_flat = ''
  assign default_key = ''

  assign c2 = 0
  assign cn = 0
  assign m2 = variant.metafields.printr.rush_2bd.value
  assign mn = variant.metafields.printr.rush_nbd.value
  if m2 != blank and m2 > 0 and fee_2bd != nil
    assign c2 = m2 | times: 100 | round
  endif
  if mn != blank and mn > 0 and fee_nbd != nil
    assign cn = mn | times: 100 | round
  endif

  if c2 > 0 or cn > 0
    assign mode = 'variant'
    assign default_key = 'standard'
    assign l_key = 'standard'
    assign l_days = std_days
    assign l_cents = '0'
    assign l_fee = '0'
    assign l_units = '0'
    assign l_flat = '0'
    if c2 > 0
      assign l_key = l_key | append: ',2bd'
      assign l_days = l_days | append: ',2'
      assign l_cents = l_cents | append: ',' | append: c2
      assign l_fee = l_fee | append: ',' | append: fee_2bd.id
      assign l_units = l_units | append: ',' | append: c2
      assign l_flat = l_flat | append: ',0'
    endif
    if cn > 0
      assign l_key = l_key | append: ',nbd'
      assign l_days = l_days | append: ',1'
      assign l_cents = l_cents | append: ',' | append: cn
      assign l_fee = l_fee | append: ',' | append: fee_nbd.id
      assign l_units = l_units | append: ',' | append: cn
      assign l_flat = l_flat | append: ',0'
    endif
  else
    assign tmeta = product.metafields.printr.turnaround.value
    if tmeta != blank and tmeta.tiers != blank
      assign n_ok = 0
      assign n_free = 0
      for t in tmeta.tiers
        capture ok
          render 'turnaround-tier-ok', tier: t, product: product, variant: variant
        endcapture
        if ok == 'yes'
          assign t_cents = t.fee | default: 0 | times: 100 | round
          assign t_fee = 0
          assign t_units = 0
          assign usable = true
          if t_cents > 0
            assign usable = false
            if t.k == 'nbd'
              assign flat_v = flat_nbd
              assign unit_v = fee_nbd
            else
              assign flat_v = flat_2bd
              assign unit_v = fee_2bd
            endif
            if flat_v != nil
              assign rem = t_cents | modulo: flat_v.price
              if rem == 0
                assign usable = true
                assign t_fee = flat_v.id
                assign t_units = t_cents | divided_by: flat_v.price
              endif
            endif
            if usable == false and unit_v != nil
              assign usable = true
              assign t_fee = unit_v.id
              assign t_units = t_cents
            endif
          else
            assign n_free = n_free | plus: 1
          endif
          if usable
            if n_ok > 0
              assign sep = ','
            else
              assign sep = ''
            endif
            assign l_key = l_key | append: sep | append: t.k
            assign l_days = l_days | append: sep | append: t.days
            assign l_cents = l_cents | append: sep | append: t_cents
            assign l_fee = l_fee | append: sep | append: t_fee
            assign l_units = l_units | append: sep | append: t_units
            assign l_flat = l_flat | append: sep | append: '1'
            if t.default and t_cents == 0
              assign default_key = t.k
            endif
            if default_key == '' and t_cents == 0 and first_free == blank
              assign first_free = t.k
            endif
            assign n_ok = n_ok | plus: 1
          endif
        endif
      endfor
      if n_free > 0
        assign mode = 'product'
        if default_key == ''
          assign default_key = first_free
        endif
      endif
    endif

    if mode == 'none'
      capture tcfg
        render 'turnaround-theme-config', product: product, variant: variant
      endcapture
      assign tcfg = tcfg | strip
      if tcfg != blank
        assign t_parts = tcfg | split: '|'
        assign t_keys = t_parts[0] | split: ','
        assign t_daysl = t_parts[1] | split: ','
        assign t_fees = t_parts[2] | split: ','
        assign n_ok = 0
        assign n_free = 0
        for k in t_keys
          assign i = forloop.index0
          assign t_cents = t_fees[i] | times: 100 | round
          assign t_fee = 0
          assign t_units = 0
          assign usable = true
          if t_cents > 0
            assign usable = false
            if k == 'nbd'
              assign flat_v = flat_nbd
              assign unit_v = fee_nbd
            else
              assign flat_v = flat_2bd
              assign unit_v = fee_2bd
            endif
            if flat_v != nil
              assign rem = t_cents | modulo: flat_v.price
              if rem == 0
                assign usable = true
                assign t_fee = flat_v.id
                assign t_units = t_cents | divided_by: flat_v.price
              endif
            endif
            if usable == false and unit_v != nil
              assign usable = true
              assign t_fee = unit_v.id
              assign t_units = t_cents
            endif
          else
            assign n_free = n_free | plus: 1
          endif
          if usable
            if n_ok > 0
              assign sep = ','
            else
              assign sep = ''
            endif
            assign l_key = l_key | append: sep | append: k
            assign l_days = l_days | append: sep | append: t_daysl[i]
            assign l_cents = l_cents | append: sep | append: t_cents
            assign l_fee = l_fee | append: sep | append: t_fee
            assign l_units = l_units | append: sep | append: t_units
            assign l_flat = l_flat | append: sep | append: '1'
            if k == t_parts[3] and t_cents == 0
              assign default_key = k
            endif
            if default_key == '' and t_cents == 0 and first_free == blank
              assign first_free = k
            endif
            assign n_ok = n_ok | plus: 1
          endif
        endfor
        if n_free > 0
          assign mode = 'product'
          if default_key == ''
            assign default_key = first_free
          endif
        endif
      endif
    endif
  endif

  assign k_arr = l_key | split: ','
  assign d_arr = l_days | split: ','
  assign c_arr = l_cents | split: ','
  assign f_arr = l_fee | split: ','
  assign u_arr = l_units | split: ','
  assign fl_arr = l_flat | split: ','
  assign has_rush = false
  if mode != 'none' and k_arr.size > 1
    assign has_rush = true
  endif

  assign uid = 'Rush-' | append: section_id
  assign form_id = 'ProductForm-' | append: section_id
  assign v_title = variant.title
  if product.has_only_default_variant
    assign v_title = ''
  endif
-%}
{%- if has_rush -%}
  <rush-turnaround class="rush" data-section="{{ section_id }}" data-form-id="{{ form_id }}" data-variant="{{ variant.id }}" data-product-url="{{ product.url }}" data-mode="{{ mode }}">
    <script type="application/json" data-rush-data>
      {
        "variant": {{ variant.id | json }},
        "price": {{ variant.price | json }},
        "title": {{ product.title | json }},
        "variantTitle": {{ v_title | json }},
        "standardDays": {{ std_days | json }},
        "money": {{ shop.money_format | json }},
        "mode": {{ mode | json }},
        "defaultTier": {{ default_key | json }},
        "tiers": [
          {%- for k in k_arr -%}
            {%- assign i = forloop.index0 -%}
            { "k": {{ k | json }}, "days": {{ d_arr[i] | plus: 0 | json }}, "cents": {{ c_arr[i] | plus: 0 | json }}, "fee": {{ f_arr[i] | plus: 0 | json }}, "units": {{ u_arr[i] | plus: 0 | json }}, "flat": {% if fl_arr[i] == '1' %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "strings": {
          "standard": {{ 'products.product.rush.standard' | t | json }},
          "two_day": {{ 'products.product.rush.two_day' | t | json }},
          "next_day": {{ 'products.product.rush.next_day' | t | json }},
          "tier_std": {{ 'products.product.rush.tier_std' | t | json }},
          "tier_2bd": {{ 'products.product.rush.tier_2bd' | t | json }},
          "tier_nbd": {{ 'products.product.rush.tier_nbd' | t | json }},
          "total": {{ 'products.product.rush.total' | t | json }},
          "price_note": {{ 'products.product.rush.price_note' | t | json }},
          "flat_note": {{ 'products.product.rush.flat_note' | t | json }},
          "reset": {{ 'products.product.rush.reset' | t | json }},
          "configurator_turnaround": {{ 'products.product.configurator.turnaround' | t | json }}
        }
      }
    </script>
    <fieldset class="rush__set">
      <legend class="rush__head">
        {%- render 'au-icon', name: 'clock', size: 18 -%}
        <span>{{ 'products.product.rush.heading' | t }}</span>
      </legend>
      {%- for k in k_arr -%}
        {%- assign i = forloop.index0 -%}
        {%- assign cents = c_arr[i] | plus: 0 -%}
        {%- assign days = d_arr[i] | plus: 0 -%}
        {%- if mode == 'variant' -%}
          {%- if k == 'standard' -%}
            {%- assign name = 'products.product.rush.standard' | t -%}
            {%- assign sub = 'products.product.rush.standard_days' | t: days: std_days -%}
            {%- assign icon = 'calendar-days' -%}
            {%- assign icon_cls = '' -%}
          {%- elsif k == '2bd' -%}
            {%- assign name = 'products.product.rush.two_day' | t -%}
            {%- assign sub = 'products.product.rush.rush_label' | t -%}
            {%- assign icon = 'zap' -%}
            {%- assign icon_cls = ' rush__ic--zap' -%}
          {%- else -%}
            {%- assign name = 'products.product.rush.next_day' | t -%}
            {%- assign sub = 'products.product.rush.fastest_label' | t -%}
            {%- assign icon = 'rocket' -%}
            {%- assign icon_cls = ' rush__ic--rocket' -%}
          {%- endif -%}
        {%- else -%}
          {%- if k == 'nbd' -%}
            {%- assign name = 'products.product.rush.tier_nbd' | t -%}
            {%- assign sub = 'products.product.rush.tier_nbd_sub' | t -%}
            {%- assign icon = 'rocket' -%}
            {%- assign icon_cls = ' rush__ic--rocket' -%}
          {%- elsif k == '2bd' -%}
            {%- assign name = 'products.product.rush.tier_2bd' | t -%}
            {%- assign sub = 'products.product.rush.tier_2bd_sub' | t -%}
            {%- assign icon = 'zap' -%}
            {%- assign icon_cls = ' rush__ic--zap' -%}
          {%- else -%}
            {%- assign name = 'products.product.rush.tier_std' | t -%}
            {%- assign sub = 'products.product.rush.standard_days' | t: days: days -%}
            {%- assign icon = 'calendar-days' -%}
            {%- assign icon_cls = '' -%}
          {%- endif -%}
        {%- endif -%}
        <label class="rush__opt">
          <input type="radio" name="{{ uid }}" value="{{ k }}" data-rush-opt{% if k == default_key %} checked{% endif %}>
          <span class="rush__radio" aria-hidden="true"></span>
          <span class="rush__ic{{ icon_cls }}" aria-hidden="true">{% render 'au-icon', name: icon, size: 20 %}</span>
          <span class="rush__txt">
            <span class="rush__name">{{ name }}</span>
            <span class="rush__sub">{{ sub }}</span>
          </span>
          {%- if cents > 0 -%}
            <span class="rush__price">+{{ cents | money }}</span>
          {%- else -%}
            <span class="rush__price rush__price--incl">{{ 'products.product.rush.included' | t }}</span>
          {%- endif -%}
        </label>
      {%- endfor -%}
    </fieldset>
    <p class="rush__total" data-rush-total aria-live="polite"></p>
    <p class="rush__note">{{ 'products.product.rush.note' | t }}</p>
    <p class="rush__reset" data-rush-reset role="status" hidden></p>
  </rush-turnaround>
  <script src="{{ 'rush-turnaround.js' | asset_url }}" type="module" defer="defer"></script>
{%- else -%}
  {%- if mode == 'product' -%}
    {%- assign only_days = d_arr[0] | plus: 0 -%}
    {%- if only_days == 1 -%}
      {%- assign only_text = 'products.product.rush.tier_nbd_sub' | t -%}
    {%- else -%}
      {%- assign only_text = 'products.product.rush.standard_days' | t: days: only_days -%}
    {%- endif -%}
    <p class="product__turnaround">{% render 'icon', name: 'clock' %}<span><strong>{{ 'products.product.turnaround' | t }}:</strong> {{ only_text }}</span></p>
  {%- else -%}
    {%- assign static_text = product.metafields.custom.turnaround | default: block.settings.text -%}
    {%- if static_text != blank -%}
      <p class="product__turnaround">{% render 'icon', name: 'clock' %}<span><strong>{{ 'products.product.turnaround' | t }}:</strong> {{ static_text }}</span></p>
    {%- endif -%}
    {%- if request.design_mode and rush_product == blank -%}
      {%- if variant.metafields.printr.rush_2bd != blank or variant.metafields.printr.rush_nbd != blank or product.metafields.printr.turnaround != blank -%}
        <p class="rush__editor-note">{{ 'products.product.rush.editor_missing_fee' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{% stylesheet %}
  .rush { --rush-line: #E3DFD4; --rush-cyan: #67D3FB; --rush-mag: #F0509C; --rush-yellow: #FEF956; display: block; background: #FAF8F3; color: #000; border: 1.5px dashed var(--rush-line); border-radius: 1.8rem; padding: 2rem 2.2rem 1.6rem; }
  .rush__set { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 1rem; }
  .rush__head { display: flex; align-items: center; gap: .8rem; padding: 0; margin: 0 0 1.2rem; font: 700 1.4rem/1.2 var(--font-heading-family); letter-spacing: .08em; text-transform: uppercase; }
  .rush__opt { position: relative; display: grid; grid-template-columns: 2rem 3.6rem 1fr auto; align-items: center; column-gap: 1.2rem; min-height: 5.6rem; padding: 1rem 1.4rem; background: #fff; border: 2px solid #000; border-radius: 1.2rem; cursor: pointer; transition: transform .12s, box-shadow .12s, background-color .15s; }
  .rush__opt:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 #000; }
  .rush__opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; padding: 0; }
  .rush__radio { width: 2rem; height: 2rem; border: 2px solid #000; border-radius: 50%; display: grid; place-items: center; background: #fff; }
  .rush__radio::after { content: ""; width: 1rem; height: 1rem; border-radius: 50%; background: #000; transform: scale(0); transition: transform .12s; }
  .rush__ic { width: 3.6rem; height: 3.6rem; border: 2px solid #000; border-radius: 50%; display: grid; place-items: center; background: #FAF8F3; }
  .rush__ic--zap { background: var(--rush-yellow); }
  .rush__ic--rocket { background: var(--rush-cyan); }
  .rush__txt { display: grid; gap: .2rem; min-width: 0; }
  .rush__name { font-weight: 700; font-size: 1.6rem; line-height: 1.25; }
  .rush__sub { font-size: 1.3rem; opacity: .7; }
  .rush__price { font-weight: 700; font-size: 1.6rem; white-space: nowrap; }
  .rush__price--incl { font: 700 1.15rem/1.2 var(--font-heading-family); letter-spacing: .12em; text-transform: uppercase; padding: .4rem 1rem; border: 2px solid #000; border-radius: 999px; background: #E3F3E8; }
  .rush__opt:has(input:checked) { background: #F3E7EA; box-shadow: 3px 3px 0 #000; }
  .rush__opt:has(input:checked) .rush__radio::after { transform: scale(1); }
  .rush__opt:has(input:focus-visible) { outline: 2px solid #000; outline-offset: 3px; }
  .rush__total { margin: 1.4rem 0 0; font-size: 1.5rem; }
  .rush__total:empty { display: none; }
  .rush__total strong { font-size: 1.8rem; }
  .rush__note { margin: .8rem 0 0; font-size: 1.25rem; opacity: .7; }
  .rush__reset { margin: 1rem 0 0; padding: .8rem 1.2rem; border: 2px solid #000; border-radius: 1rem; background: #FFF915; font-size: 1.3rem; }
  .rush__editor-note { margin: .8rem 0 0; padding: .8rem 1.2rem; border: 2px dashed #000; border-radius: 1rem; font-size: 1.3rem; }
  .price__rush { display: block; font-size: 1.3rem; font-weight: 600; opacity: .75; margin-top: .2rem; }
  .product:has(rush-turnaround) brochure-configurator .bc-sec:has([data-bc-turn]) { display: none; }
  @media (max-width: 749px) {
    .rush { padding: 1.6rem 1.4rem 1.2rem; }
    .rush__opt { grid-template-columns: 2rem 1fr auto; padding: 1rem 1.2rem; }
    .rush__ic { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .rush__opt, .rush__radio::after { transition: none; } .rush__opt:hover { transform: none; } }
{% endstylesheet %}
