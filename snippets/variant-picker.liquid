{% doc %}
  Variant picker with pills (or swatches for color options) using combined listing friendly option values.
  @param {product} product - The product
  @param {string} section_id - Section id to re-render
  @param {boolean} [update_url] - Update the browser URL on change
  @example
  {% render 'variant-picker', product: product, section_id: section.id %}
{% enddoc %}
{%- unless product.has_only_default_variant -%}
  <variant-picker class="variant-picker" data-section="{{ section_id }}" data-url="{{ product.url }}" data-update-url="{{ update_url | default: true }}" data-swap="picker">
    {%- for option in product.options_with_values -%}
      <fieldset class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
        <legend>{{ option.name }}: <span class="variant-picker__value">{{ option.selected_value }}</span></legend>
        {%- if option.values.size > 8 -%}
          <select id="Option-{{ section_id }}-{{ forloop.index0 }}" aria-label="{{ option.name }}">
            {%- for value in option.values -%}
              <option value="{{ value | escape }}" data-option-value-id="{{ value.id }}" data-ok="{% if value.exists and value.available %}1{% elsif value.exists %}2{% else %}0{% endif %}" {% if value.selected %}selected{% endif %}>{{ value }}{% unless value.available %} – {{ 'products.product.unavailable' | t }}{% endunless %}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <div class="pills">
            {%- for value in option.values -%}
              {%- assign input_id = 'Opt-' | append: section_id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
              <input type="radio" class="visually-hidden" id="{{ input_id }}" name="{{ option.name | handle }}-{{ section_id }}" value="{{ value | escape }}" data-option-value-id="{{ value.id }}" data-option-focus="{{ value.id }}" data-ok="{% if value.exists and value.available %}1{% elsif value.exists %}2{% else %}0{% endif %}" {% if value.selected %}checked{% endif %}>
              <label for="{{ input_id }}" class="pill{% unless value.available %} is-unavailable{% endunless %}{% if value.swatch %} pill--swatch{% endif %}" {% if value.swatch.color %}style="--swatch: {{ value.swatch.color }}"{% endif %}>
                {%- if value.swatch -%}<span class="swatch" aria-hidden="true" {% if value.swatch.image %}style="background-image: url({{ value.swatch.image | image_url: width: 60 }})"{% endif %}></span>{%- endif -%}
                <span>{{ value }}</span>
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </variant-picker>
{%- endunless -%}
{% stylesheet %}
  .variant-picker { display: grid; gap: 2rem; }
  .variant-picker__option { border: 0; padding: 0; margin: 0; }
  .variant-picker__option legend { font-weight: 600; margin-bottom: 1rem; font-size: 1.4rem; }
  .variant-picker__value { font-weight: 400; opacity: .75; }
  .pills { display: flex; flex-wrap: wrap; gap: .8rem; }
  .pill { display: inline-flex; align-items: center; gap: .8rem; min-height: 4.4rem; padding: 0 1.8rem; border: 1px solid rgb(var(--color-border)); border-radius: var(--radius-button); cursor: pointer; font-weight: 500; transition: border-color .2s; }
  .pill:hover { border-color: rgb(var(--color-foreground)); }
  input:checked + .pill { border-color: rgb(var(--color-foreground)); background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }
  input:focus-visible + .pill { outline: 2px solid var(--m); outline-offset: 2px; }
  .pill.is-unavailable { text-decoration: line-through; opacity: .5; }
{% endstylesheet %}
