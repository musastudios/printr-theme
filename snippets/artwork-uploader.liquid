      "cancel": {{ 'artwork.cancel' | t | json }},
      "analyzing": {{ 'artwork.analyzing' | t | json }},
      "analyzing_sub": {{ 'artwork.analyzing_sub' | t | json }},
      "badge_needed": {{ 'artwork.badge_needed' | t | json }},
      "badge_checking": {{ 'artwork.badge_checking' | t | json }},
      "badge_ready": {{ 'artwork.badge_ready' | t | json }},
      "badge_warn": {{ 'artwork.badge_warn' | t | json }},
      "badge_warn_one": {{ 'artwork.badge_warn_one' | t | json }},
      "badge_err": {{ 'artwork.badge_err' | t | json }},
      "badge_err_one": {{ 'artwork.badge_err_one' | t | json }},
      "sum_empty": {{ 'artwork.sum_empty' | t | json }},
