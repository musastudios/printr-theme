      "close_tip": {{ 'artwork.close_tip' | t | json }},
      "remove_front": {{ 'artwork.remove_front' | t | json }},
      "remove_back": {{ 'artwork.remove_back' | t | json }},
      "front_side": {{ 'artwork.front_side' | t | json }},
      "back_side": {{ 'artwork.back_side' | t | json }},
      "view_3d": {{ 'artwork.view_3d' | t | json }},
      "open_preview": {{ 'artwork.open_preview' | t | json }},
      "upload_artwork": {{ 'artwork.upload_artwork' | t | json }},
      "replace_files": {{ 'artwork.replace_files' | t | json }},
      "template_short": {{ 'artwork.template_short' | t | json }},
      "landscape": {{ 'artwork.landscape' | t | json }},
      "portrait": {{ 'artwork.portrait' | t | json }},
