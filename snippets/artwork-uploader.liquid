{% doc %}
  Artwork upload + client-side preflight studio. Files are attached to the line item
  through native line item property file inputs associated with the product form.
  @param {product} [product] - Product being configured (omit on the upload-artwork page)
  @param {string} section_id - Section id (used to target ProductForm-<section_id>)
  @param {object} [block] - Block with uploader settings
  @param {string} [form_id] - Form to attach to (defaults to ProductForm-<section_id>)
  @param {boolean} [standalone] - Post-checkout upload page: no send-later, QA or cart gate extras
  @param {string} [terms_url] - Artwork terms page URL
  @example
  {% render 'artwork-uploader', product: product, section_id: section.id, block: block %}
{% enddoc %}
{%- liquid
  if form_id == blank
    assign form_id = 'ProductForm-' | append: section_id
  endif
  assign terms_url = terms_url | default: block.settings.terms_url | default: settings.artwork_terms_url | default: '/pages/artwork-terms'
  assign uid = 'AU-' | append: section_id
  assign mf = product.metafields.custom
  assign profile = mf.print_profile.value
  assign product_spec = mf.print_spec.value | default: profile.default_size.value
  assign template_url = profile.template_url.value
  if profile.template_file.value != blank
    assign template_url = profile.template_file.value.url | default: template_url
  endif
  assign sides = mf.sides.value | default: block.settings.sides | default: 1
  assign sides = sides | plus: 0
  assign bleed = mf.bleed_in.value | default: block.settings.bleed_in | default: 0.125
  assign safe = mf.safe_in.value | default: block.settings.safe_in | default: 0.125
  assign min_dpi = mf.min_dpi.value | default: 300
  assign max_mb = block.settings.max_mb | default: 20
  assign trim_w = mf.trim_width_in.value | default: 0
  assign trim_h = mf.trim_height_in.value | default: 0
  assign size_index = -1
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'size' or oname == 'tamaño' or oname == 'tamano'
      assign size_index = forloop.index0
    endif
  endfor
-%}
<artwork-uploader
  class="au"
  style="--au-ok: {{ settings.artwork_ok_color | default: '#0B7A3B' }}; --au-okbg: {{ settings.artwork_ok_bg | default: '#E3F3E8' }}; --au-warn: {{ settings.artwork_warn_color | default: '#8A5300' }}; --au-warnbg: {{ settings.artwork_warn_bg | default: '#FFF1D2' }};"
  data-form-id="{{ form_id }}"
  data-sides="{{ sides }}"
  data-bleed="{{ bleed }}"
  data-safe="{{ safe }}"
  data-min-dpi="{{ min_dpi }}"
  data-max-mb="{{ max_mb }}"
  data-trim-w="{{ trim_w }}"
  data-trim-h="{{ trim_h }}"
  data-size-index="{{ size_index }}"
  data-variant="{{ product.selected_or_first_available_variant.id }}"
  data-fee-variant="{{ block.settings.qa_product.selected_or_first_available_variant.id }}"
  data-product-title="{{ product.title | escape }}"
  data-section="{{ section_id }}"
  {% if standalone %}data-standalone{% endif %}
>
  <script type="application/json" data-au-variants>
    [
      {%- for v in product.variants -%}
        {"id":{{ v.id }},"options":{{ v.options | json }}
        {%- if v.metafields.custom.print_spec.value != blank -%}
          ,"spec":{% render 'print-spec-json', spec: v.metafields.custom.print_spec.value %}
        {%- endif -%}
        }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-au-profile>
    {
      "name":{{ profile.name.value | json }},
      "mode":{{ profile.mode.value | json }},
      "color_mode":{{ profile.color_mode.value | json }},
      "formats":{{ profile.formats.value | json }},
      "guidance":{{ profile.guidance.value | json }},
      "template_url":{{ template_url | json }},
      "product_spec":{% render 'print-spec-json', spec: product_spec %},
      "sizes":[
        {%- for sz in profile.sizes.value -%}
          {% render 'print-spec-json', spec: sz %}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
  {%- comment -%} One block per size: print_spec handle -> its template download (empty = use profile template). {%- endcomment -%}
  {%- for sz in profile.sizes.value -%}
    <script type="application/json" data-au-size-template>
      {"handle":{{ sz.system.handle | json }},"label":{{ sz.label.value | json }},"trim_w_in":{{ sz.trim_w_in.value | json }},"trim_h_in":{{ sz.trim_h_in.value | json }},"template_url":{{ sz.template_file.value.url | json }}}
    </script>
  {%- endfor -%}
  <script type="application/json" data-au-strings>
    {
      "files_uploaded": {{ 'artwork.files_uploaded' | t | json }},
      "no_warnings": {{ 'artwork.no_warnings' | t | json }},
      "missing_file": {{ 'artwork.missing_file' | t | json }},
      "bad_format": {{ 'artwork.bad_format' | t | json }},
      "too_large": {{ 'artwork.too_large' | t | json }},
      "dpi_low": {{ 'artwork.dpi_low' | t | json }},
      "dpi_too_low": {{ 'artwork.dpi_too_low' | t | json }},
      "dpi_ok": {{ 'artwork.dpi_ok' | t | json }},
      "orientation": {{ 'artwork.orientation' | t | json }},
      "aspect": {{ 'artwork.aspect' | t | json }},
      "cmyk": {{ 'artwork.cmyk' | t | json }},
      "rgb": {{ 'artwork.rgb' | t | json }},
      "pdf_size": {{ 'artwork.pdf_size' | t | json }},
