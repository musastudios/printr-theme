      "sum_warn": {{ 'artwork.sum_warn' | t | json }},
      "sum_warn_one": {{ 'artwork.sum_warn_one' | t | json }},
      "sum_err": {{ 'artwork.sum_err' | t | json }},
      "sum_err_one": {{ 'artwork.sum_err_one' | t | json }},
      "preflight_heading": {{ 'artwork.preflight_heading' | t | json }},
      "ck_size": {{ 'artwork.ck_size' | t | json }},
      "ck_size_detail": {{ 'artwork.ck_size_detail' | t | json }},
      "ck_dpi": {{ 'artwork.ck_dpi' | t | json }},
      "ck_dpi_detail": {{ 'artwork.ck_dpi_detail' | t | json }},
      "ck_dpi_vector": {{ 'artwork.ck_dpi_vector' | t | json }},
      "ck_format": {{ 'artwork.ck_format' | t | json }},
      "ck_ratio": {{ 'artwork.ck_ratio' | t | json }},
      "ck_safe": {{ 'artwork.ck_safe' | t | json }},
      "ck_safe_detail": {{ 'artwork.ck_safe_detail' | t | json }},
      "ck_folds": {{ 'artwork.ck_folds' | t | json }},
      "ck_contour": {{ 'artwork.ck_contour' | t | json }},
      "ck_area": {{ 'artwork.ck_area' | t | json }},
      "ck_area_warn": {{ 'artwork.ck_area_warn' | t | json }},
      "ck_bg": {{ 'artwork.ck_bg' | t | json }},
      "ck_sleeve": {{ 'artwork.ck_sleeve' | t | json }},
      "notes": {{ 'artwork.notes' | t | json }},
      "st_ok": {{ 'artwork.st_ok' | t | json }},
      "st_warn": {{ 'artwork.st_warn' | t | json }},
      "st_err": {{ 'artwork.st_err' | t | json }},
      "st_wait": {{ 'artwork.st_wait' | t | json }},
      "st_run": {{ 'artwork.st_run' | t | json }},
      "st_review": {{ 'artwork.st_review' | t | json }},
      "fix_fit": {{ 'artwork.fix_fit' | t | json }},
      "fix_replace": {{ 'artwork.fix_replace' | t | json }},
      "fix_move": {{ 'artwork.fix_move' | t | json }},
      "ack": {{ 'artwork.ack' | t | json }},
      "ack_one": {{ 'artwork.ack_one' | t | json }},
      "ack_help": {{ 'artwork.ack_help' | t | json }},
      "note": {{ 'artwork.note' | t | json }},
      "hint": {{ 'artwork.hint' | t | json }},
      "lg_bleed": {{ 'artwork.lg_bleed' | t | json }},
      "lg_cut": {{ 'artwork.lg_cut' | t | json }},
      "lg_safe": {{ 'artwork.lg_safe' | t | json }},
      "lg_fold": {{ 'artwork.lg_fold' | t | json }},
      "lg_contour": {{ 'artwork.lg_contour' | t | json }},
      "lg_area": {{ 'artwork.lg_area' | t | json }},
      "lg_sleeve": {{ 'artwork.lg_sleeve' | t | json }},
      "scale_chip": {{ 'artwork.scale_chip' | t | json }},
      "step_title": {{ 'artwork.step_title' | t | json }},
      "needs_review": {{ 'artwork.needs_review' | t | json }},
