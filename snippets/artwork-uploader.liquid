      "files_heading": {{ 'artwork.files_heading' | t | json }},
      "sides_count": {{ 'artwork.sides_count' | t | json }},
      "drop_main": {{ 'artwork.drop_main' | t | json }},
      "drop_canvas_front": {{ 'artwork.drop_canvas_front' | t | json }},
