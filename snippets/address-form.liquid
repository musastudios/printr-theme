{%- doc -%}
  Renders the fields of a customer address form.
  @param {object} form - The address form object
  @param {string} id - Unique suffix for field ids
{%- enddoc -%}
<address-form class="address-form">
  <div class="field-row">
    <div class="field"><label for="AF-first-{{ id }}">{{ 'customer.register.first_name' | t }}</label><input id="AF-first-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
    <div class="field"><label for="AF-last-{{ id }}">{{ 'customer.register.last_name' | t }}</label><input id="AF-last-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
  </div>
  <div class="field"><label for="AF-company-{{ id }}">{{ 'customer.addresses.company' | t }}</label><input id="AF-company-{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
  <div class="field"><label for="AF-a1-{{ id }}">{{ 'customer.addresses.address1' | t }}</label><input id="AF-a1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
  <div class="field"><label for="AF-a2-{{ id }}">{{ 'customer.addresses.address2' | t }}</label><input id="AF-a2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
  <div class="field-row">
    <div class="field"><label for="AF-city-{{ id }}">{{ 'customer.addresses.city' | t }}</label><input id="AF-city-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
    <div class="field"><label for="AF-zip-{{ id }}">{{ 'sections.cart.estimate.zip' | t }}</label><input id="AF-zip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
  </div>
  <div class="field-row">
    <div class="field"><label for="AF-country-{{ id }}">{{ 'sections.cart.estimate.country' | t }}</label><select id="AF-country-{{ id }}" name="address[country]" data-country data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select></div>
    <div class="field" data-province-wrap><label for="AF-province-{{ id }}">{{ 'sections.cart.estimate.province' | t }}</label><select id="AF-province-{{ id }}" name="address[province]" data-province data-default="{{ form.province }}" autocomplete="address-level1"></select></div>
  </div>
  <div class="field"><label for="AF-phone-{{ id }}">{{ 'customer.addresses.phone' | t }}</label><input type="tel" id="AF-phone-{{ id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
  <label class="check"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox contains 'checked' %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}</label>
</address-form>
