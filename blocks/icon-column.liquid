<div class="icon-column{% if block.settings.image != blank %} icon-column--media{% endif %}" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    <div class="icon-column__media">
      {{ block.settings.image | image_url: width: 800 | image_tag: widths: '200, 300, 400, 600, 800', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title }}
    </div>
  {%- else -%}
    <span class="icon-column__icon">{% render 'icon', name: block.settings.icon %}</span>
  {%- endif -%}
  <div>
    <h3 class="icon-column__title">{{ block.settings.title | escape }}</h3>
    {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
  </div>
</div>
{% stylesheet %}
  .icon-column { display: flex; gap: 1.6rem; align-items: flex-start; }
  .icon-column__icon { display: grid; place-items: center; width: 5.2rem; height: 5.2rem; border-radius: 50%; background: rgb(var(--color-accent)); color: rgb(var(--color-background)); flex: none; }
  .icon-column__title { font-size: 1.7rem; margin: 0 0 .4rem; }
  .icon-column .rte p { margin: 0; opacity: .8; font-size: 1.4rem; }
  .icon-column--media { flex-direction: column; gap: 1.2rem; }
  .icon-column__media { width: 100%; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; background: rgba(var(--color-foreground), .05); }
  .icon-column__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
{% endstylesheet %}
{% schema %}
{
  "name": "Icon column",
  "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "truck", "label": "Truck" }, { "value": "print", "label": "Printer" }, { "value": "clock", "label": "Clock" }, { "value": "chat", "label": "Chat" }, { "value": "check", "label": "Check" }], "default": "print" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Replaces the icon when set. Square works best." },
    { "type": "text", "id": "title", "label": "Title", "default": "Premium stock" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>16pt matte, gloss, soft-touch and more.</p>" }
  ],
  "presets": [{ "name": "Icon column" }]
}
{% endschema %}
