<div class="block-group block-group--{{ block.settings.direction }}" style="--gap: {{ block.settings.gap }}px" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>
{% stylesheet %}
  .block-group { display: flex; gap: var(--gap); flex-wrap: wrap; }
  .block-group--column { flex-direction: column; align-items: flex-start; }
{% endstylesheet %}
{% schema %}
{
  "name": "Group",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    { "type": "select", "id": "direction", "label": "Direction", "options": [{ "value": "column", "label": "Vertical" }, { "value": "row", "label": "Horizontal" }], "default": "column" },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Group" }]
}
{% endschema %}
