<div class="slide color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
  <div class="slide__media">
    {%- if block.settings.image != blank -%}
      {%- assign focal = block.settings.image.presentation.focal_point | prepend: 'object-position: ' -%}{{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', style: focal }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="slide__content page-width">
    <div class="slide__box crop">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% stylesheet %}
  .slide { position: relative; min-height: clamp(48rem, 75vh, 82rem); display: grid; flex: 0 0 100%; scroll-snap-align: start; overflow: hidden; }
  .slide__media { position: absolute; inset: 0; }
  .slide__media img, .slide__media svg { width: 100%; height: 100%; object-fit: cover; }
  .slide__content { position: relative; display: flex; align-items: flex-end; padding-block: 6rem; width: 100%; }
  .slide__box { background: rgb(var(--color-background)); padding: clamp(2.4rem, 4vw, 4.8rem); border-radius: var(--radius); max-width: 64rem; display: flex; flex-direction: column; gap: 1.6rem; align-items: flex-start; }
{% endstylesheet %}
{% schema %}
{
  "name": "Slide",
  "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }, { "type": "group" }],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Content box color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Slide", "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }] }]
}
{% endschema %}
